            "author_association": "MEMBER",
            "body": "This is an artifact from @echasnovski's personal configuration. It likely should be removed from MiniMax.\n\nWith that said, it's an incredibly useful custom picker if you happen to keep all of your repos in one parent directory. It creates a two-stage picker where you first select the \"project\" (a repo directory), and then you select a file using a normal file picker.\n\nI liked the idea so much that I created one for my installed plug-ins as well as projects. Below is the code I use to create my custom `:Pick projects` and `:Pick plugins` which I bind to mappings of course:\n\n```lua\n-- Plugin picker\nlocal plugin_dir = vim.fn.stdpath(\"data\") .. \"/site/pack/core/opt\"\nMiniPick.registry.plugins = H.two_stage_dir_picker(plugin_dir, \"Plugin Picker\")\n\n-- Project picker\nlocal repo_dir = vim.fn.expand(\"~/repos\")\nMiniPick.registry.projects = H.two_stage_dir_picker(repo_dir, \"Repo Picker\")\n\n-- Creates a two-stage directory picker. First stage picks a directory inside\n-- `dir` with the explorer, then the second stage opens a file picker inside\n-- the chosen directory.\nH.two_stage_dir_picker = function(dir, name)\n  local pred = function(item)\n    return item.text ~= \"..\"\n  end\n  local choose = function(item)\n    vim.schedule(function()\n      MiniPick.builtin.files(nil, { source = { name = item.text, cwd = item.path } })\n    end)\n  end\n  return function()\n    local local_opts = { cwd = dir, filter = pred }\n    local opts = { source = { name = name, choose = choose } }\n    return MiniExtra.pickers.explorer(local_opts, opts)\n  end\nend\n```",
