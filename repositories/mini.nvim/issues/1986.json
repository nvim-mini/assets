        {
            "author_association": "NONE",
            "body": "I tested with Neovim v0.11.4 and it works fine, so it could be a problem with Neovim nightly as you say.\n\nI can reproduce the issue with this example code, move the cursor inside the `<button>Copy</button>` tag and the `onClick` function.\n\n```tsx\nimport { useState } from \"react\";\n\ntype DropdownMenuProps = {\n    textToCopy: string;\n};\n\nexport default function DropdownMenu({ textToCopy }: DropdownMenuProps) {\n    const [open, setOpen] = useState(false);\n    const [copied, setCopied] = useState(false);\n\n    return (\n        <div style={{ position: \"relative\", display: \"inline-block\" }}>\n            {/* Button to toggle menu */}\n            <button onClick={() => setOpen((prev) => !prev)}>☰ Menu</button>\n\n            {/* Dropdown */}\n            {open && (\n                <ul\n                    style={{\n                        position: \"absolute\",\n                        top: \"100%\",\n                        left: 0,\n                        background: \"#fff\",\n                        border: \"1px solid #ccc\",\n                        borderRadius: 4,\n                        padding: \"0.5rem\",\n                        listStyle: \"none\",\n                        margin: 0,\n                        minWidth: \"120px\",\n                        zIndex: 10,\n                    }}\n                >\n                    <li>\n                        <button\n                            style={{ width: \"100%\", textAlign: \"left\" }}\n                            onClick={async () => {\n                                try {\n                                    await navigator.clipboard.writeText(\n                                        textToCopy,\n                                    );\n                                    setCopied(true);\n                                    setTimeout(() => setCopied(false), 1500); // Reset message\n                                } catch (err) {\n                                    console.error(\"Failed to copy: \", err);\n                                }\n                                setOpen(false);\n                            }}\n                        >\n                            📋 Copy\n                        </button>\n                    </li>\n                </ul>\n            )}\n\n            {/* Feedback */}\n            {copied && (\n                <span\n                    style={{\n                        marginLeft: \"0.5rem\",\n                        fontSize: \"0.9rem\",\n                        color: \"green\",\n                    }}\n                >\n                    Copied!\n                </span>\n            )}\n        </div>\n    );\n}\n```\n",
