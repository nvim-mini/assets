            "author_association": "MEMBER",
            "body": "@echasnovski, after all the `autocommands` you considered on my behalf, I have another solution...)\n\nThis restores highlighting in both directions for the given scenario. All tests pass.\n\n```diff\ndiff --git a/lua/mini/jump.lua b/lua/mini/jump.lua\nindex 1f9b3f37..597a6859 100644\n--- a/lua/mini/jump.lua\n+++ b/lua/mini/jump.lua\n@@ -232,7 +232,12 @@ MiniJump.jump = function(target, backward, till, n_times)\n \n   -- Ensure to undo \"consume a character\" effect in Operator-pending expression\n   -- mapping if there is no target found. Do it here to also act on dot-repeat.\n-  if is_expr and not has_jumped then vim.schedule(function() vim.cmd('undo!') end) end\n+  if is_expr and not has_jumped then\n+    vim.schedule(function()\n+      H.cache.is_operator_pending_undo = true\n+      vim.cmd('undo!')\n+    end)\n+  end\n end\n \n --- Make smart jump\n@@ -301,6 +306,9 @@ H.cache = {\n   -- Latest cursor position data\n   latest_cursor = nil,\n \n+  -- The undo command prevented a character to be consumed\n+  is_operator_pending_undo = false,\n+\n   -- Whether helper message was shown\n   msg_shown = false,\n }\n@@ -411,11 +419,17 @@ end\n -- Autocommands ---------------------------------------------------------------\n H.on_cursormoved = function()\n   -- Check if jumping to avoid unnecessary actions on every CursorMoved\n-  if MiniJump.state.jumping then\n-    H.cache.n_cursor_moved = H.cache.n_cursor_moved + 1\n-    -- Stop jumping only if `CursorMoved` was not a result of smart jump\n-    if H.cache.n_cursor_moved > 1 then MiniJump.stop_jumping() end\n+  if not MiniJump.state.jumping then return end\n+\n+  -- Ignore CursorMoved when jump() used the undo command\n+  if H.cache.is_operator_pending_undo then\n+    H.cache.is_operator_pending_undo = false\n+    return\n   end\n+\n+  H.cache.n_cursor_moved = H.cache.n_cursor_moved + 1\n+  -- Stop jumping only if `CursorMoved` was not a result of smart jump\n+  if H.cache.n_cursor_moved > 1 then MiniJump.stop_jumping() end\n end\n \n H.stop_if_curbuf = function(ev)\n\n```",
