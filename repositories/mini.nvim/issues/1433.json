            "body": "Temporary workaround:\r\n```lua\r\nH.set_extmark = function(buffer, ns_id, line, col, opts)\r\n  if line == 0 then\r\n    local li = vim.api.nvim_buf_get_extmarks(buffer, ns_id, { line, col }, { line, col }, {})\r\n    if #li > 0 then\r\n      vim.api.nvim_buf_del_extmark(buffer, ns_id, li[1][1])\r\n    end\r\n  end\r\n  pcall(vim.api.nvim_buf_set_extmark, buffer, ns_id, line, col, opts)\r\nend\r\n```",
