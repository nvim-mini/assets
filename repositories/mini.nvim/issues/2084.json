    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "Setting `cursorlineopt=number` disables cursor line globally (and in 'mini.files' in particular). There should be one of `line`, `screenline`, or `both` flag present for cursor line to be visible in 'mini.files' and globally.",
