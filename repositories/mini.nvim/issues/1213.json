            "author_association": "NONE",
            "body": "```lua\r\n{\r\n    'echasnovski/mini.sessions',\r\n    event = 'VimEnter',\r\n    version = false,\r\n    opts = function(_, opts)\r\n    local force = { read = false, write = true, delete = true}\r\n      opts.directory = vim.fn.stdpath('data') .. '/sessions'\r\n      opts.file = ''\r\n      opts.force = force\r\n    end,\r\n    keys = {\r\n      {\r\n        '<leader>qs',\r\n        function()\r\n          local session = require('mini.sessions')\r\n          vim.ui.input({ prompt = 'Save session name : ' }, function(input)\r\n              if input == nil then return end\r\n\r\n              local session_name = input:gsub('%s', '')\r\n              if session_name == '' or session_name == nil then\r\n                print('Please input session name')\r\n                return\r\n              end\r\n\r\n              session_name = input:gsub('[^%w%.%-]', '-')\r\n              session.write(session_name)\r\n              print(session_name .. ' session save ok')\r\n            end)\r\n        end,\r\n        desc = 'Save Sessions',\r\n      },\r\n      {\r\n        '<leader>ql',\r\n        function()\r\n          local session = require('mini.sessions')\r\n          session.select('read')\r\n        end,\r\n        desc = 'Load Sessions',\r\n      },\r\n      {\r\n        '<leader>qd',\r\n        function()\r\n          local session = require('mini.sessions')\r\n          local starter = require('mini.starter')\r\n          session.select('delete')\r\n          starter.refresh()\r\n        end,\r\n        desc = 'Delete Sessions',\r\n      },\r\n    },\r\n  }\r\n```\r\n\r\nAs shown on your screen, I also have no issues during testing. I set a specific keymap to trigger session deletion and refresh, but it is not working.",
