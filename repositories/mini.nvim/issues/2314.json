        {
            "author_association": "NONE",
            "body": "I understand your concerns but the amount of code required to this by default is only 3-4 lines. We only need to add a callback function as a parameter that filters the directory names.  Something like this\n```\n  local should_enter_dir = function(dir_name)\n    return dir_name ~= \".git\" and dir_name ~= \"node_modules\"\n  end\n\n  local f = function()\n    local items = {}\n    for path, path_type in vim.fs.dir(cwd, {depth = math.huge, skip = should_enter_dir}) do\n      if not poke_picker() then return end\n      if path_type == 'file' and is_file_text(string.format('%s/%s', cwd, path)) then\n        -- print(path)\n        table.insert(items, path)\n      end\n    end\n    MiniPick.set_picker_items(items)\n  end\n```",
