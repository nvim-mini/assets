    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "Hello @echasnovski,\r\n\r\nThanks for creating this feature-request!\r\n\r\nI think the current alphabetic sorting is just fine. However, group-items(\"git\", \"search\") are in the same sorted list as items that directly execute an action(\"Harpoon UI\") .\r\n\r\nIn LazyVim, when pressing the leader key, items that directly execute an action are added first, sorted alphabetically. Then, the group items are added, also sorted alphabetically.\r\nFor me personally, those two \"virtual\" blocks are easier to scan, as the most important keys will be on top.\r\n\r\nBest regards!\r\n\r\n",
            "created_at": "2023-08-25T10:41:13Z",
            "html_url": "https://github.com/nvim-mini/mini.nvim/issues/454#issuecomment-1693158693",
