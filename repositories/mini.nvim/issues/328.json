    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "Columns are not shrunk, but the opposite - they are padded (from left and/or right). Try using `trim` step with custom merge character. \r\n\r\nThat is:\r\n- Visually select region to be aligned.\r\n- Press `gA` to initiate interactive align.\r\n- Press `&` to align by it.\r\n- Press `t` to trim whitespace.\r\n- Press `m` followed by `<Space>` and `<CR>` (Enter).",
            "created_at": "2023-05-16T14:43:09Z",
