    "comment_data": [
        {
            "author_association": "NONE",
            "body": "Just add a filetype autocommand (or ftplugin) that sets `commentstring` appropriately for blueprint files.\r\n\r\n(Unlike comment.nvim, mini.comment does _not_ handle commentstring itself and relies on the standard Vim mechanism for it -- rightfully so.)",
            "created_at": "2023-06-01T07:00:50Z",
            "html_url": "https://github.com/nvim-mini/mini.nvim/issues/351#issuecomment-1571471609",
            "id": 1571471609,
