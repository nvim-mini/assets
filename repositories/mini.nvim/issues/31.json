                "html_url": "https://github.com/jesseleite",
                "id": 5187394,
                "login": "jesseleite",
                "node_id": "MDQ6VXNlcjUxODczOTQ=",
                "organizations_url": "https://api.github.com/users/jesseleite/orgs",
                "received_events_url": "https://api.github.com/users/jesseleite/received_events",
                "repos_url": "https://api.github.com/users/jesseleite/repos",
