        {
            "author_association": "MEMBER",
            "body": "@ahmedreda1009, on latest `main` there is now [`get_explorer_state()`](https://github.com/echasnovski/mini.nvim/blob/73f2e7a596bbb4e6ae6728d3a4426221ffc9512d/doc/mini-files.txt#L807) function. It can be used inside custom buffer-local mappings to have a more straightforward \"don't go outside of initial path\" logic. For example, with something like this:\r\n\r\n```lua\r\nrequire('mini.files').setup({ mappings = { go_out = '' } })\r\n\r\n-- Make `go_out` to not go outside of initial path (a.k.a. \"anchor\")\r\nlocal go_out_restricted = function()\r\n  local state = MiniFiles.get_explorer_state()\r\n  local cur_win_id, cur_path = vim.api.nvim_get_current_win(), nil\r\n  for _, win_data in ipairs(state.windows) do\r\n    if win_data.win_id == cur_win_id then cur_path = win_data.path end\r\n  end\r\n  if cur_path == state.anchor then return print('Cannot navigate outside the initial directory.') end\r\n  MiniFiles.go_out()\r\nend\r\n\r\nlocal map_go_out = function(args)\r\n  local rhs = function()\r\n    for _ = 1, vim.v.count1 do\r\n      go_out_restricted()\r\n    end\r\n  end\r\n  vim.keymap.set('n', 'h', rhs, { buffer = args.data.buf_id })\r\nend\r\nvim.api.nvim_create_autocmd('User', { pattern = 'MiniFilesBufferCreate', callback = map_go_out })\r\n```",
