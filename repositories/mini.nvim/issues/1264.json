    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "This is already [the case with 'mini.files'](https://github.com/echasnovski/mini.nvim/blob/e52ac74bd4e9c0ce6a182ee551eb099236b5a89d/doc/mini-files.txt#L593) and it is enabled by default. To achieve this effect the 'mini.files' itself shouldn't be lazy loaded (otherwise Neovim itself doesn't about 'mini.files' at the time it decides what to do when opening a directory).",
            "created_at": "2024-10-07T20:19:19Z",
            "html_url": "https://github.com/nvim-mini/mini.nvim/issues/1264#issuecomment-2397814277",
