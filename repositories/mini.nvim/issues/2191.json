    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "Thanks for the suggestion!\n\nCan you, please, clarify what you mean by \"include support for Italic and Bold\"? Does it mean an extra option that if enabled would add bold/italic to some highlight group(s)?",
