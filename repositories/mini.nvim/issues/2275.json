            "author_association": "MEMBER",
            "body": "A better repro:\n\n```lua\nvim.pack.add({ \"https://github.com/nvim-mini/mini.nvim\" })\n\nlocal vim_ui_select = vim.ui.select\nrequire(\"mini.pick\").setup()\nrequire(\"mini.files\").setup()\nvim.ui.select = vim_ui_select\n\n-- Directory to select, starting mini.files\nlocal test_dir = \"~/.config/repro\"\nlocal items = { vim.fn.fnameescape(test_dir) }\n\n-- Type `:lua _G.with_pick()`\n_G.with_pick = function() MiniPick.start({ source = { items = items } }) end\n\n-- Type `:lua _G.with_ui_select()`\n_G.with_ui_select = function()\n  vim.ui.select(items, nil, function(item)\n    if not item then return end\n    vim.cmd(\"edit \" .. item)\n  end, items)\nend\n\n```",
