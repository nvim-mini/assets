    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "Thanks for suggestion, but I don't think this is a good idea. For at least these reasons:\r\n- It would introduce duplication of clues for  \"suggested\" setup with all `gen_clues` entries.\r\n- It would be visible only if `g` is set as trigger, which it doesn't have to be for marks.\r\n- It is not much burden to add for people who both use `g` as trigger and `gen_clues.marks()` but not `gen_clues.g()` as clues.\r\n\r\nClosing as not planned.",
            "created_at": "2023-09-27T07:08:04Z",
