            "author_association": "NONE",
            "body": "Thanks @echasnovski by doing a small update to what you shared which is using virtual_lines, I was able to achieve very similar while keeping the match highlights (not perfect but close enough)\n\n``` lua\nlocal show = function(buf_id, items_to_show, query)\n  vim.api.nvim_buf_clear_namespace(buf_id, ns_id, 0, -1)\n  MiniPick.default_show(buf_id, items_to_show, query, { show_icons = false })\n\n  local extmark_opts = { virt_text_pos = 'inline' }\n  for i = 1, #items_to_show do\n    local line_nr = i - 1\n    local file = items_to_show[i]\n    local basename = vim.fs.basename(file)\n    local icon, hl = MiniIcons.get('file', file)\n    extmark_opts.virt_text = { { icon .. ' ', hl}, { basename .. ' ', 'MiniPickNormal' } }\n    vim.api.nvim_buf_set_extmark(buf_id, ns_id, line_nr, 0, extmark_opts)\n\n    local file_opts = { end_row = i, end_col = 0, hl_mode = 'blend', hl_group = 'Comment', priority = 199 }\n    vim.api.nvim_buf_set_extmark(buf_id, ns_id, line_nr, 0 , file_opts)\n  end\n```\n\n<img width=\"949\" height=\"552\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f6cb683f-8ace-4321-8fda-aae5f4b7c547\" />",
