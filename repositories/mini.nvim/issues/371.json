    "author_association": "NONE",
    "body": "I've the following conf to use mini.nvim\r\n```lua\r\nlocal spec = {\r\n  \"echasnovski/mini.nvim\",\r\n  name = \"mini\",\r\n  version = '*',\r\n  event = { \"InsertEnter\" },\r\n}\r\n\r\nfunction spec:config()\r\n  local pairs = require(\"mini.pairs\")\r\n\r\n  pairs.setup({\r\n    modes = { insert = true, command = false, terminal = false },\r\n\r\n    mappings = {\r\n      ['('] = { action = 'open', pair = '()', neigh_pattern = '[^\\\\].' },\r\n      ['['] = { action = 'open', pair = '[]', neigh_pattern = '[^\\\\].' },\r\n      ['{'] = { action = 'open', pair = '{}', neigh_pattern = '[^\\\\].' },\r\n\r\n      [')'] = { action = 'close', pair = '()', neigh_pattern = '[^\\\\].' },\r\n      [']'] = { action = 'close', pair = '[]', neigh_pattern = '[^\\\\].' },\r\n      ['}'] = { action = 'close', pair = '{}', neigh_pattern = '[^\\\\].' },\r\n\r\n      ['\"'] = { action = 'closeopen', pair = '\"\"', neigh_pattern = '[^\\\\].', register = { cr = false } },\r\n      [\"'\"] = { action = 'closeopen', pair = \"''\", neigh_pattern = '[^%a\\\\].', register = { cr = false } },\r\n      ['`'] = { action = 'closeopen', pair = '``', neigh_pattern = '[^\\\\].', register = { cr = false } },\r\n    },\r\n  })\r\n\r\nend\r\n\r\n\r\nreturn spec\r\n\r\n\r\n```\r\n\r\nI want to use mini.colors, can we pass the configuration for mini.colors in the same file and lazy load only other components/plugins from mini.nvim but not colors?\r\n",
