        {
            "author_association": "NONE",
            "body": "@echasnovski So rust-analyzer publishes diagnostics for the whole workspace and I tried to make it work with this snippet, but I'm not that proficient in neovim/lua and there is no icons, can I have some guidance on how to do it properly for mini.files?\n\n```lua\n\nlocal function get_diagnostics_by_file()\n    local diagnostics_by_file = {}\n    local diagnostics = vim.diagnostic.get(nil)  -- All diagnostics in the workspace\n\n    for _, diag in ipairs(diagnostics) do\n        local filename = vim.api.nvim_buf_get_name(diag.bufnr)\n        local existing = diagnostics_by_file[filename] or {}\n        table.insert(existing, diag)\n        diagnostics_by_file[filename] = existing\n    end\n\n    return diagnostics_by_file\nend\n\nlocal function get_max_severity_for_files()\n    local file_diagnostics = get_diagnostics_by_file()\n    local severity_by_file = {}\n\n    for file, diags in pairs(file_diagnostics) do\n        local max_severity = vim.diagnostic.severity.HINT  -- Least severe\n        for _, d in ipairs(diags) do\n            if d.severity < max_severity then  -- Lower number = more severe\n                max_severity = d.severity\n            end\n        end\n        severity_by_file[file] = max_severity\n    end\n\n    return severity_by_file\nend\n\nrequire(\"mini.files\").setup {\n    options = {\n        use_as_default_explorer = false,\n    },\n    content = {\n        -- Custom formatter for file names\n        prefix = function(entry)\n            local severity_colors = {\n                [vim.diagnostic.severity.ERROR] = \"%#DiagnosticError#\",\n                [vim.diagnostic.severity.WARN]  = \"%#DiagnosticWarn#\",\n                [vim.diagnostic.severity.INFO]  = \"%#DiagnosticInfo#\",\n                [vim.diagnostic.severity.HINT]  = \"%#DiagnosticHint#\",\n            }\n\n            local filename = entry.path\n            local severities = get_max_severity_for_files()\n            local severity = severities[filename]\n\n            if severity then\n                return severity_colors[severity] .. \"● \" .. \"%*\"\n            else\n                return \"  \"\n            end\n        end,\n    }\n}\n\n```",
