                }
            },
            "author_association": "MEMBER",
            "body": "I had my doubts about whether or not `H.str_byteindex` should only be defined conditionally inside of the below check for `vim.fn.has('nvim-0.10') == 0` as it is the only usage of `vim.str_byteindex` in this module. But, in the end decided against it because it seemed cleaner.",
            "commit_id": "58596b8cbe92710a47f84ed08b0642bce3d73bc9",
            "copilot_code_review_sources": [],
            "created_at": "2025-12-29T03:43:43Z",
            "diff_hunk": "@@ -2031,9 +2031,21 @@ if vim.fn.has('nvim-0.10') == 0 then\n   end\n end\n \n+-- TODO: Remove after compatibility with Neovim=0.10 is dropped\n+H.str_utfindex = vim.fn.has('nvim-0.11') == 1 and function(s, i) return vim.str_utfindex(s, 'utf-32', i) end\n+  or function(s, i)\n+    -- Use first returned value (UTF-32 index, and not UTF-16 one)\n+    local res = vim.str_utfindex(s, i)\n+    return res\n+  end\n+\n+-- TODO: Remove after compatibility with Neovim=0.10 is dropped\n+H.str_byteindex = vim.fn.has('nvim-0.11') == 1 and function(s, i) return vim.str_byteindex(s, 'utf-32', i) end",
            "html_url": "https://github.com/nvim-mini/mini.nvim/pull/2199#discussion_r2650130157",
