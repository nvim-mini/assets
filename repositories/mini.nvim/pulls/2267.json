            "author_association": "MEMBER",
            "body": "Would you mind creating these session files permanently? This will require adjusting another test for detecting global sessions, but I think it will be worth it (please use `--stylua:ignore` to group relevant session files on the same line and not spread one per line; this is to save space).",
            "commit_id": "5ad901c23cac66dafbebbe0b2974592b0adb81ba",
            "copilot_code_review_sources": [],
            "created_at": "2026-02-14T12:32:51Z",
            "diff_hunk": "@@ -342,6 +342,46 @@ T['read()']['accepts only name of detected session'] = function()\n   validate_no_session_loaded()\n end\n \n+T['read()']['removes stale local session from detected'] = function()\n+  local session_cd_global = 'tests/dir-sessions/global/session_cd_global'\n+  local session_cd_local = 'tests/dir-sessions/global/session_cd_local'\n+  local session_cd_local_2 = 'tests/dir-sessions/global/session_cd_local_2'\n+  MiniTest.finally(function()\n+    vim.fn.delete(session_cd_global)\n+    vim.fn.delete(session_cd_local)\n+    vim.fn.delete(session_cd_local_2)\n+  end)\n+\n+  local write_lines = function(session, target_dir)\n+    local marker_line = 'lua _G.session_file = ' .. vim.inspect(session)\n+    local cd_line = ('lua vim.fn.chdir(\"%s\")'):format(project_root .. '/tests/dir-sessions/' .. target_dir)\n+    child.fn.writefile({ marker_line, cd_line }, session)\n+  end\n+  write_lines(session_cd_global, 'global')\n+  write_lines(session_cd_local, 'local')\n+  write_lines(session_cd_local_2, 'local-2')",
