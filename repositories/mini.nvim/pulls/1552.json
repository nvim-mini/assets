                "url": "https://api.github.com/repos/nvim-mini/mini.nvim/issues/comments/2635699544/reactions"
            },
            "updated_at": "2025-02-05T04:55:18Z",
            "url": "https://api.github.com/repos/nvim-mini/mini.nvim/issues/comments/2635699544",
            "user": {
