            "author_association": "MEMBER",
            "body": "1. `vim.fn.getbufinfo()[buf_id]` is not the correct way of getting buffer information, as the function returns array and not a map. It is `vim.fn.getbufinfo(buf_id)[1]`.\n2. I don't think I like the `not_listed` name and there is no obvious name for this. So I'd go with something like this:\n\n    ```lua\n    local did_ensure = {}\n    local ensure_triggers = vim.schedule_wrap(function(ev)\n      if not H.is_valid_buf(ev.buf) then return end\n      -- NOTE: Special case command-line window as it is not listed on Neovim>=0.13\n      local is_cmdwin = vim.fn.getbufinfo(ev.buf)[1].command == 1\n      local skip_triggers = did_ensure[ev.buf] or not (vim.bo[ev.buf].buflisted or is_cmdwin)\n      did_ensure[ev.buf] = true\n      if ev.event == 'BufWinEnter' and skip_triggers then return end\n      MiniClue.ensure_buf_triggers(ev.buf)\n    end)\n    ```",
            "commit_id": "fcc826d564a13b0fde14fcb9c867b685676e00b3",
            "copilot_code_review_sources": [],
            "created_at": "2026-06-26T11:44:48Z",
            "diff_hunk": "@@ -1246,9 +1246,10 @@ H.create_autocommands = function()\n   -- delay acting until buffer is loaded (otherwise buffer-local options can be\n   -- prematurely \"finalized\"). Process it at most once for performance.\n   local did_ensure = {}\n+  local not_listed = function(buf_id) return vim.fn.buflisted(buf_id) ~= 1 and vim.fn.getbufinfo()[buf_id].command ~= 1 end",
            "html_url": "https://github.com/nvim-mini/mini.nvim/pull/2483#discussion_r3481152466",
            "id": 3481152466,
