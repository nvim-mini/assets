    "comment_data": [],
    "comment_regular_data": [
        {
            "author_association": "NONE",
            "body": "It seems like this [test](https://github.com/echasnovski/mini.nvim/blob/1cd8d7e8318071eddc536815f5cafe50b012ac29/tests/test_ai.lua?plain=1#L2558) is failing. Any ideas on how to re-adjust the pattern to satisfy an empty tag name as well?",
