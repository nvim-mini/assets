                    "resourcePath": "/nvim-mini/mini.nvim/discussions/2154#discussioncomment-15179875",
                    "updatedAt": "2025-12-06T12:50:33Z",
                    "upvoteCount": 0,
                    "url": "https://github.com/nvim-mini/mini.nvim/discussions/2154#discussioncomment-15179875"
