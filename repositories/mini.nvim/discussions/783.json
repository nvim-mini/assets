<span class=\"pl-k\">=</span> {\n        <span class=\"pl-smi\">hex_color</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">hipatterns</span>.<span class=\"pl-e\">gen_highlighter</span>.<span class=\"pl-c1\">hex_color</span>(),\n        <span class=\"pl-smi\">fixme</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">hi_words</span>({ <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>FIXME<span class=\"pl-pds\">\" </span></span>}, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>MiniHipatternsFixme<span class=\"pl-pds\">\"</span></span>),\n        <span class=\"pl-smi\">todo</span>  <span class=\"pl-k\">=</span> <span class=\"pl-c1\">hi_words</span>({ <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>TODO<span class=\"pl-pds\">\" </span></span>},  <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>MiniHipatternsTodo<span class=\"pl-pds\">\"</span></span>),\n        <span class=\"pl-smi\">note</span>  <span class=\"pl-k\">=</span> <span class=\"pl-c1\">hi_words</span>({ <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>NOTE<span class=\"pl-pds\">\" </span></span>},  <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>MiniHipatternsNote<span class=\"pl-pds\">\"</span></span>),\n        <span class=\"pl-smi\">hack</span>  <span class=\"pl-k\">=</span> <span class=\"pl-c1\">hi_words</span>({ <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>HACK<span class=\"pl-pds\">\" </span></span>},  <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>MiniHipatternsHack<span class=\"pl-pds\">\"</span></span>),\n      }</pre></div>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://private-user-images.githubusercontent.com/747855/320242651-13ecd1fb-df51-46b4-a3be-b7a48289b5fc.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJnaXRodWIuY29tIiwiYXVkIjoicmF3LmdpdGh1YnVzZXJjb250ZW50LmNvbSIsImtleSI6ImtleTUiLCJleHAiOjE3OTM1NTM0NTksIm5iZiI6MTc5MzU1MzE1OSwicGF0aCI6Ii83NDc4NTUvMzIwMjQyNjUxLTEzZWNkMWZiLWRmNTEtNDZiNC1hM2JlLWI3YTQ4Mjg5YjVmYy5wbmc_.xp-Srrym10a1rvCStHXmDM88Fp7UyssOq3MEWGCEtK8\"><img width=\"933\" alt=\"image\" src=\"https://private-user-images.githubusercontent.com/747855/320242651-13ecd1fb-df51-46b4-a3be-b7a48289b5fc.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJnaXRodWIuY29tIiwiYXVkIjoicmF3LmdpdGh1YnVzZXJjb250ZW50LmNvbSIsImtleSI6ImtleTUiLCJleHAiOjE3OTM1NTM0NTksIm5iZiI6MTc5MzU1MzE1OSwicGF0aCI6Ii83NDc4NTUvMzIwMjQyNjUxLTEzZWNkMWZiLWRmNTEtNDZiNC1hM2JlLWI3YTQ4Mjg5YjVmYy5wbmc_.xp-Srrym10a1rvCStHXmDM88Fp7UyssOq3MEWGCEtK8\" style=\"max-width: 100%;\"></a>",
    "bodyText": "Thought I'd share my highlighting rules for mini.hipatterns, which mimics folke's todo-comments in the event others might be interested.\nSpecifically, it ensures the keyword's reverse text has a single space on the left and right side of the word. The space on the right side is created by hiding the colon using the same fg and bg color. Finally, it uses the reverse color as the foreground for the remainder of the line.\n      opts.highlighters = {\n        hex_color   = hipatterns.gen_highlighter.hex_color(),\n        fixme       = { pattern = \"() FIXME():\",   group = \"MiniHipatternsFixme\" },\n        hack        = { pattern = \"() HACK():\",    group = \"MiniHipatternsHack\" },\n        todo        = { pattern = \"() TODO():\",    group = \"MiniHipatternsTodo\" },\n        note        = { pattern = \"() NOTE():\",    group = \"MiniHipatternsNote\" },\n        fixme_colon = { pattern = \" FIXME():()\",   group = \"MiniHipatternsFixmeColon\" },\n        hack_colon  = { pattern = \" HACK():()\",    group = \"MiniHipatternsHackColon\" },\n        todo_colon  = { pattern = \" TODO():()\",    group = \"MiniHipatternsTodoColon\" },\n        note_colon  = { pattern = \" NOTE():()\",    group = \"MiniHipatternsNoteColon\" },\n        fixme_body  = { pattern = \" FIXME:().*()\", group = \"MiniHipatternsFixmeBody\" },\n        hack_body   = { pattern = \" HACK:().*()\",  group = \"MiniHipatternsHackBody\" },\n        todo_body   = { pattern = \" TODO:().*()\",  group = \"MiniHipatternsTodoBody\" },\n        note_body   = { pattern = \" NOTE:().*()\",  group = \"MiniHipatternsNoteBody\" },\n      }\n\nFor comparison, here is the version using mini.extras.gen_highlighter:\n      local hi_words = require(\"mini.extra\").gen_highlighter.words\n      -- stylua: ignore\n      opts.highlighters = {\n        hex_color = hipatterns.gen_highlighter.hex_color(),\n        fixme = hi_words({ \"FIXME\" }, \"MiniHipatternsFixme\"),\n        todo  = hi_words({ \"TODO\" },  \"MiniHipatternsTodo\"),\n        note  = hi_words({ \"NOTE\" },  \"MiniHipatternsNote\"),\n        hack  = hi_words({ \"HACK\" },  \"MiniHipatternsHack\"),\n      }",
