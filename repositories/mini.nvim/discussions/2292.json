        "updatedAt": "2022-01-02T14:24:09Z"
    },
    "closed": true,
    "closedAt": "2026-03-03T09:15:24Z",
    "comment_count": 1,
    "comment_data": [
        {
            "author": {
                "avatarUrl": "https://avatars.githubusercontent.com/u/119845045?u=9e2489487d1e983158fa9026e290027a273bd2be&v=4",
                "login": "drowning-cat",
                "resourcePath": "/drowning-cat",
                "url": "https://github.com/drowning-cat"
            },
            "authorAssociation": "CONTRIBUTOR",
            "body": "You can simply try:\r\n\r\n```lua\r\nvim.o.laststatus = 3\r\n```\r\nIf you only want `laststatus = 3` while you're in diff view, I'd probably do something like this (though there may be a better approach):\r\n\r\n```lua\r\nlocal laststatus_au = vim.api.nvim_create_augroup(\"set_laststatus\", { clear = true })\r\nlocal laststatus = vim.o.laststatus\r\nvim.api.nvim_create_autocmd(\"OptionSet\", {\r\n  pattern = \"laststatus\",\r\n  group = laststatus_au,\r\n  callback = function()\r\n    laststatus = vim.o.laststatus\r\n  end,\r\n})\r\nlocal set_status = function()\r\n  local ei = vim.o.eventignore\r\n  vim.o.eventignore = \"OptionSet\"\r\n  vim.o.laststatus = vim.wo.diff and 3 or laststatus\r\n  vim.o.eventignore = ei\r\nend\r\nvim.api.nvim_create_autocmd(\"OptionSet\", { pattern = \"diff\", group = laststatus_au, callback = set_status })\r\nvim.api.nvim_create_autocmd(\"WinEnter\", { group = laststatus_au, callback = set_status })\r\n```",
            "bodyHTML": "<p dir=\"auto\">You can simply try:</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"vim.o.laststatus = 3\"><pre class=\"notranslate\"><span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">o</span>.<span class=\"pl-e\">laststatus</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">3</span></pre></div>\n<p dir=\"auto\">If you only want <code class=\"notranslate\">laststatus = 3</code> while you're in diff view, I'd probably do something like this (though there may be a better approach):</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"local laststatus_au = vim.api.nvim_create_augroup(&quot;set_laststatus&quot;, { clear = true })\nlocal laststatus = vim.o.laststatus\nvim.api.nvim_create_autocmd(&quot;OptionSet&quot;, {\n  pattern = &quot;laststatus&quot;,\n  group = laststatus_au,\n  callback = function()\n    laststatus = vim.o.laststatus\n  end,\n})\nlocal set_status = function()\n  local ei = vim.o.eventignore\n  vim.o.eventignore = &quot;OptionSet&quot;\n  vim.o.laststatus = vim.wo.diff and 3 or laststatus\n  vim.o.eventignore = ei\nend\nvim.api.nvim_create_autocmd(&quot;OptionSet&quot;, { pattern = &quot;diff&quot;, group = laststatus_au, callback = set_status })\nvim.api.nvim_create_autocmd(&quot;WinEnter&quot;, { group = laststatus_au, callback = set_status })\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-smi\">laststatus_au</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_augroup</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>set_laststatus<span class=\"pl-pds\">\"</span></span>, { <span class=\"pl-smi\">clear</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">true</span> })\n<span class=\"pl-k\">local</span> <span class=\"pl-smi\">laststatus</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">o</span>.<span class=\"pl-e\">laststatus</span>\n<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_autocmd</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>OptionSet<span class=\"pl-pds\">\"</span></span>, {\n  <span class=\"pl-smi\">pattern</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>laststatus<span class=\"pl-pds\">\"</span></span>,\n  <span class=\"pl-smi\">group</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">laststatus_au</span>,\n  <span class=\"pl-en\">callback</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n    <span class=\"pl-smi\">laststatus</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">o</span>.<span class=\"pl-e\">laststatus</span>\n  <span class=\"pl-k\">end</span>,\n})\n<span class=\"pl-k\">local</span> <span class=\"pl-en\">set_status</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">ei</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">o</span>.<span class=\"pl-e\">eventignore</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">o</span>.<span class=\"pl-e\">eventignore</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>OptionSet<span class=\"pl-pds\">\"</span></span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">o</span>.<span class=\"pl-e\">laststatus</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">wo</span>.<span class=\"pl-e\">diff</span> <span class=\"pl-k\">and</span> <span class=\"pl-c1\">3</span> <span class=\"pl-k\">or</span> <span class=\"pl-smi\">laststatus</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">o</span>.<span class=\"pl-e\">eventignore</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">ei</span>\n<span class=\"pl-k\">end</span>\n<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_autocmd</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>OptionSet<span class=\"pl-pds\">\"</span></span>, { <span class=\"pl-smi\">pattern</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>diff<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">group</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">laststatus_au</span>, <span class=\"pl-smi\">callback</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">set_status</span> })\n<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_autocmd</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>WinEnter<span class=\"pl-pds\">\"</span></span>, { <span class=\"pl-smi\">group</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">laststatus_au</span>, <span class=\"pl-smi\">callback</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">set_status</span> })</pre></div>",
            "bodyText": "You can simply try:\nvim.o.laststatus = 3\nIf you only want laststatus = 3 while you're in diff view, I'd probably do something like this (though there may be a better approach):\nlocal laststatus_au = vim.api.nvim_create_augroup(\"set_laststatus\", { clear = true })\nlocal laststatus = vim.o.laststatus\nvim.api.nvim_create_autocmd(\"OptionSet\", {\n  pattern = \"laststatus\",\n  group = laststatus_au,\n  callback = function()\n    laststatus = vim.o.laststatus\n  end,\n})\nlocal set_status = function()\n  local ei = vim.o.eventignore\n  vim.o.eventignore = \"OptionSet\"\n  vim.o.laststatus = vim.wo.diff and 3 or laststatus\n  vim.o.eventignore = ei\nend\nvim.api.nvim_create_autocmd(\"OptionSet\", { pattern = \"diff\", group = laststatus_au, callback = set_status })\nvim.api.nvim_create_autocmd(\"WinEnter\", { group = laststatus_au, callback = set_status })",
