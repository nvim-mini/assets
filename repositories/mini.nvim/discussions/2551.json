    "authorAssociation": "NONE",
    "body": "<img width=\"900\" height=\"849\" alt=\"mcursor_minifiles\" src=\"https://github.com/user-attachments/assets/e03e017e-b6b4-4736-b6e1-9ac4a33a228f\" />\r\n\r\n```lua\r\n  local function constrain_cursor(win, buf)\r\n    if not vim.api.nvim_win_is_valid(win) then return end\r\n    if not vim.api.nvim_buf_is_valid(buf) then return end\r\n    local ns = vim.api.nvim_create_namespace(\"nvim.multicursor\")\r\n    local extmarks = vim.api.nvim_buf_get_extmarks(buf, ns, 0, -1)\r\n    if #extmarks == 0 then return end\r\n    for _, e in ipairs(extmarks) do\r\n      local id, r, c = e[1], e[2], e[3] ---@type integer, integer, integer\r\n      local line = vim.api.nvim_buf_get_lines(buf, r - 1, r, false)[1]\r\n      if line then\r\n        local _, name_start = line:match(\"^/%d+/().-()/\")\r\n        if name_start and name_start > c then\r\n          vim.api.nvim_buf_set_extmark(buf, ns, r, name_start --[[@as integer]], { id = id })\r\n        end\r\n      end\r\n    end\r\n  end\r\n\r\n  vim.api.nvim_create_autocmd(\"User\", {\r\n    pattern = \"MiniFilesWindowUpdate\",\r\n    callback = function(ev) constrain_cursor(ev.data.win_id, ev.data.buf_id) end,\r\n  })\r\n```\r\n\r\nTo be honest, I'm not sure whether it's completely correct, I'm just sharing it. 😄",
    "bodyHTML": "<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://private-user-images.githubusercontent.com/32360281/652372425-e03e017e-b6b4-4736-b6e1-9ac4a33a228f.gif?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..PmbUn-aMhHMCfMfucWYwQN5fS2-SyqzMG_mcsR2tBdg\"><img width=\"900\" height=\"849\" alt=\"mcursor_minifiles\" src=\"https://private-user-images.githubusercontent.com/32360281/652372425-e03e017e-b6b4-4736-b6e1-9ac4a33a228f.gif?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..PmbUn-aMhHMCfMfucWYwQN5fS2-SyqzMG_mcsR2tBdg\" data-animated-image=\"\" style=\"max-width: 100%; height: auto; max-height: 849px;; aspect-ratio: 900 / 849; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"  local function constrain_cursor(win, buf)\n    if not vim.api.nvim_win_is_valid(win) then return end\n    if not vim.api.nvim_buf_is_valid(buf) then return end\n    local ns = vim.api.nvim_create_namespace(&quot;nvim.multicursor&quot;)\n    local extmarks = vim.api.nvim_buf_get_extmarks(buf, ns, 0, -1)\n    if #extmarks == 0 then return end\n    for _, e in ipairs(extmarks) do\n      local id, r, c = e[1], e[2], e[3] ---@type integer, integer, integer\n      local line = vim.api.nvim_buf_get_lines(buf, r - 1, r, false)[1]\n      if line then\n        local _, name_start = line:match(&quot;^/%d+/().-()/&quot;)\n        if name_start and name_start &gt; c then\n          vim.api.nvim_buf_set_extmark(buf, ns, r, name_start --[[@as integer]], { id = id })\n        end\n      end\n    end\n  end\n\n  vim.api.nvim_create_autocmd(&quot;User&quot;, {\n    pattern = &quot;MiniFilesWindowUpdate&quot;,\n    callback = function(ev) constrain_cursor(ev.data.win_id, ev.data.buf_id) end,\n  })\"><pre class=\"notranslate\">  <span class=\"pl-k\">local</span> <span class=\"pl-k\">function</span> <span class=\"pl-en\">constrain_cursor</span>(<span class=\"pl-smi\">win</span>, <span class=\"pl-smi\">buf</span>)\n    <span class=\"pl-k\">if</span> <span class=\"pl-k\">not</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_win_is_valid</span>(<span class=\"pl-smi\">win</span>) <span class=\"pl-k\">then</span> <span class=\"pl-k\">return</span> <span class=\"pl-k\">end</span>\n    <span class=\"pl-k\">if</span> <span class=\"pl-k\">not</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_buf_is_valid</span>(<span class=\"pl-smi\">buf</span>) <span class=\"pl-k\">then</span> <span class=\"pl-k\">return</span> <span class=\"pl-k\">end</span>\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">ns</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_namespace</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>nvim.multicursor<span class=\"pl-pds\">\"</span></span>)\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">extmarks</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_buf_get_extmarks</span>(<span class=\"pl-smi\">buf</span>, <span class=\"pl-smi\">ns</span>, <span class=\"pl-c1\">0</span>, <span class=\"pl-k\">-</span><span class=\"pl-c1\">1</span>)\n    <span class=\"pl-k\">if</span> <span class=\"pl-k\">#</span><span class=\"pl-smi\">extmarks</span> <span class=\"pl-k\">==</span> <span class=\"pl-c1\">0</span> <span class=\"pl-k\">then</span> <span class=\"pl-k\">return</span> <span class=\"pl-k\">end</span>\n    <span class=\"pl-k\">for</span> <span class=\"pl-smi\">_</span>, <span class=\"pl-smi\">e</span> <span class=\"pl-k\">in</span> <span class=\"pl-c1\">ipairs</span>(<span class=\"pl-smi\">extmarks</span>) <span class=\"pl-k\">do</span>\n      <span class=\"pl-k\">local</span> <span class=\"pl-smi\">id</span>, <span class=\"pl-smi\">r</span>, <span class=\"pl-smi\">c</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">e</span>[<span class=\"pl-c1\">1</span>], <span class=\"pl-smi\">e</span>[<span class=\"pl-c1\">2</span>], <span class=\"pl-smi\">e</span>[<span class=\"pl-c1\">3</span>] <span class=\"pl-c\"><span class=\"pl-c\">---</span><span class=\"pl-k\">@type</span> <span class=\"pl-c1\">integer</span><span class=\"pl-k\">, </span><span class=\"pl-c1\">integer</span><span class=\"pl-k\">, </span><span class=\"pl-c1\">integer</span></span>\n      <span class=\"pl-k\">local</span> <span class=\"pl-smi\">line</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_buf_get_lines</span>(<span class=\"pl-smi\">buf</span>, <span class=\"pl-smi\">r</span> <span class=\"pl-k\">-</span> <span class=\"pl-c1\">1</span>, <span class=\"pl-smi\">r</span>, <span class=\"pl-c1\">false</span>)[<span class=\"pl-c1\">1</span>]\n      <span class=\"pl-k\">if</span> <span class=\"pl-smi\">line</span> <span class=\"pl-k\">then</span>\n        <span class=\"pl-k\">local</span> <span class=\"pl-smi\">_</span>, <span class=\"pl-smi\">name_start</span> <span class=\"pl-k\">=</span> <span class=\"pl-en\">line</span>:<span class=\"pl-c1\">match</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>^/%d+/().-()/<span class=\"pl-pds\">\"</span></span>)\n        <span class=\"pl-k\">if</span> <span class=\"pl-smi\">name_start</span> <span class=\"pl-k\">and</span> <span class=\"pl-smi\">name_start</span> <span class=\"pl-k\">&gt;</span> <span class=\"pl-smi\">c</span> <span class=\"pl-k\">then</span>\n          <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_buf_set_extmark</span>(<span class=\"pl-smi\">buf</span>, <span class=\"pl-smi\">ns</span>, <span class=\"pl-smi\">r</span>, <span class=\"pl-smi\">name_start</span> <span class=\"pl-c\"><span class=\"pl-c\">--[[</span>@as integer<span class=\"pl-c\">]]</span></span>, { <span class=\"pl-smi\">id</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">id</span> })\n        <span class=\"pl-k\">end</span>\n      <span class=\"pl-k\">end</span>\n    <span class=\"pl-k\">end</span>\n  <span class=\"pl-k\">end</span>\n\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_autocmd</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>User<span class=\"pl-pds\">\"</span></span>, {\n    <span class=\"pl-smi\">pattern</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>MiniFilesWindowUpdate<span class=\"pl-pds\">\"</span></span>,\n    <span class=\"pl-en\">callback</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>(<span class=\"pl-smi\">ev</span>) <span class=\"pl-c1\">constrain_cursor</span>(<span class=\"pl-smi\">ev</span>.<span class=\"pl-e\">data</span>.<span class=\"pl-e\">win_id</span>, <span class=\"pl-smi\">ev</span>.<span class=\"pl-e\">data</span>.<span class=\"pl-e\">buf_id</span>) <span class=\"pl-k\">end</span>,\n  })</pre></div>\n<p dir=\"auto\">To be honest, I'm not sure whether it's completely correct, I'm just sharing it. 😄</p>",
    "bodyText": "local function constrain_cursor(win, buf)\n    if not vim.api.nvim_win_is_valid(win) then return end\n    if not vim.api.nvim_buf_is_valid(buf) then return end\n    local ns = vim.api.nvim_create_namespace(\"nvim.multicursor\")\n    local extmarks = vim.api.nvim_buf_get_extmarks(buf, ns, 0, -1)\n    if #extmarks == 0 then return end\n    for _, e in ipairs(extmarks) do\n      local id, r, c = e[1], e[2], e[3] ---@type integer, integer, integer\n      local line = vim.api.nvim_buf_get_lines(buf, r - 1, r, false)[1]\n      if line then\n        local _, name_start = line:match(\"^/%d+/().-()/\")\n        if name_start and name_start > c then\n          vim.api.nvim_buf_set_extmark(buf, ns, r, name_start --[[@as integer]], { id = id })\n        end\n      end\n    end\n  end\n\n  vim.api.nvim_create_autocmd(\"User\", {\n    pattern = \"MiniFilesWindowUpdate\",\n    callback = function(ev) constrain_cursor(ev.data.win_id, ev.data.buf_id) end,\n  })\nTo be honest, I'm not sure whether it's completely correct, I'm just sharing it. 😄",
