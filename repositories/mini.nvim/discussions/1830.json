    "closedAt": "2025-05-28T10:53:14Z",
    "comment_count": 2,
    "comment_data": [
        {
            "author": {
                "avatarUrl": "https://avatars.githubusercontent.com/u/24854248?u=d09fd974c6720eba3039db6beb2f1c1efecdb51d&v=4",
                "login": "echasnovski",
                "resourcePath": "/echasnovski",
                "url": "https://github.com/echasnovski"
            },
            "authorAssociation": "MEMBER",
            "body": "It is possible, yes. This requires writing custom section instead of using `section_filename`:\r\n\r\n```lua\r\nlocal my_filename = function()\r\n  -- In terminal always use plain name\r\n  if vim.bo.buftype == 'terminal' then return '%t' end\r\n  local modified = vim.bo.modified and '❌' or '✅'\r\n  return (MiniStatusline.is_truncated(140) and '%f' or '%F') .. modified .. '%r'\r\nend\r\n```\r\n\r\nYou can use it in combination with [default active content](https://github.com/echasnovski/mini.nvim/blob/ecbb9b1e2223a04171388887765e7695f5a0c132/doc/mini-statusline.txt#L86C1-L106C6) like this:\r\n\r\n```lua\r\nlocal active_content = function()\r\n  local mode, mode_hl = MiniStatusline.section_mode({ trunc_width = 120 })\r\n  local git = MiniStatusline.section_git({ trunc_width = 40 })\r\n  local diff = MiniStatusline.section_diff({ trunc_width = 75 })\r\n  local diagnostics = MiniStatusline.section_diagnostics({ trunc_width = 75 })\r\n  local lsp = MiniStatusline.section_lsp({ trunc_width = 75 })\r\n  local filename = my_filename()\r\n  local fileinfo = MiniStatusline.section_fileinfo({ trunc_width = 120 })\r\n  local location = MiniStatusline.section_location({ trunc_width = 75 })\r\n  local search = MiniStatusline.section_searchcount({ trunc_width = 75 })\r\n\r\n  return MiniStatusline.combine_groups({\r\n    { hl = mode_hl, strings = { mode } },\r\n    { hl = 'MiniStatuslineDevinfo', strings = { git, diff, diagnostics, lsp } },\r\n    '%<', -- Mark general truncate point\r\n    { hl = 'MiniStatuslineFilename', strings = { filename } },\r\n    '%=', -- End left alignment\r\n    { hl = 'MiniStatuslineFileinfo', strings = { fileinfo } },\r\n    { hl = mode_hl, strings = { search, location } },\r\n  })\r\nend\r\nrequire('mini.statusline').setup({ content = { active = active_content } })\r\n```",
            "bodyHTML": "<p dir=\"auto\">It is possible, yes. This requires writing custom section instead of using <code class=\"notranslate\">section_filename</code>:</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"local my_filename = function()\n  -- In terminal always use plain name\n  if vim.bo.buftype == 'terminal' then return '%t' end\n  local modified = vim.bo.modified and '❌' or '✅'\n  return (MiniStatusline.is_truncated(140) and '%f' or '%F') .. modified .. '%r'\nend\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-en\">my_filename</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-c\"><span class=\"pl-c\">--</span> In terminal always use plain name</span>\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">bo</span>.<span class=\"pl-e\">buftype</span> <span class=\"pl-k\">==</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>terminal<span class=\"pl-pds\">' </span></span><span class=\"pl-k\">then</span> <span class=\"pl-k\">return</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%t<span class=\"pl-pds\">' </span></span><span class=\"pl-k\">end</span>\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">modified</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">bo</span>.<span class=\"pl-e\">modified</span> <span class=\"pl-k\">and</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>❌<span class=\"pl-pds\">' </span></span><span class=\"pl-k\">or</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>✅<span class=\"pl-pds\">'</span></span>\n  <span class=\"pl-k\">return</span> (<span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">is_truncated</span>(<span class=\"pl-c1\">140</span>) <span class=\"pl-k\">and</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%f<span class=\"pl-pds\">' </span></span><span class=\"pl-k\">or</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%F<span class=\"pl-pds\">'</span></span>) <span class=\"pl-k\">..</span> <span class=\"pl-smi\">modified</span> <span class=\"pl-k\">..</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%r<span class=\"pl-pds\">'</span></span>\n<span class=\"pl-k\">end</span></pre></div>\n<p dir=\"auto\">You can use it in combination with <a href=\"https://github.com/echasnovski/mini.nvim/blob/ecbb9b1e2223a04171388887765e7695f5a0c132/doc/mini-statusline.txt#L86C1-L106C6\">default active content</a> like this:</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"local active_content = function()\n  local mode, mode_hl = MiniStatusline.section_mode({ trunc_width = 120 })\n  local git = MiniStatusline.section_git({ trunc_width = 40 })\n  local diff = MiniStatusline.section_diff({ trunc_width = 75 })\n  local diagnostics = MiniStatusline.section_diagnostics({ trunc_width = 75 })\n  local lsp = MiniStatusline.section_lsp({ trunc_width = 75 })\n  local filename = my_filename()\n  local fileinfo = MiniStatusline.section_fileinfo({ trunc_width = 120 })\n  local location = MiniStatusline.section_location({ trunc_width = 75 })\n  local search = MiniStatusline.section_searchcount({ trunc_width = 75 })\n\n  return MiniStatusline.combine_groups({\n    { hl = mode_hl, strings = { mode } },\n    { hl = 'MiniStatuslineDevinfo', strings = { git, diff, diagnostics, lsp } },\n    '%&lt;', -- Mark general truncate point\n    { hl = 'MiniStatuslineFilename', strings = { filename } },\n    '%=', -- End left alignment\n    { hl = 'MiniStatuslineFileinfo', strings = { fileinfo } },\n    { hl = mode_hl, strings = { search, location } },\n  })\nend\nrequire('mini.statusline').setup({ content = { active = active_content } })\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-en\">active_content</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">mode</span>, <span class=\"pl-smi\">mode_hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_mode</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">120</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">git</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_git</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">40</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">diff</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_diff</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">75</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">diagnostics</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_diagnostics</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">75</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">lsp</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_lsp</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">75</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">filename</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">my_filename</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">fileinfo</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_fileinfo</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">120</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">location</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_location</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">75</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">search</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_searchcount</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">75</span> })\n\n  <span class=\"pl-k\">return</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">combine_groups</span>({\n    { <span class=\"pl-smi\">hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">mode_hl</span>, <span class=\"pl-smi\">strings</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">mode</span> } },\n    { <span class=\"pl-smi\">hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>MiniStatuslineDevinfo<span class=\"pl-pds\">'</span></span>, <span class=\"pl-smi\">strings</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">git</span>, <span class=\"pl-smi\">diff</span>, <span class=\"pl-smi\">diagnostics</span>, <span class=\"pl-smi\">lsp</span> } },\n    <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%&lt;<span class=\"pl-pds\">'</span></span>, <span class=\"pl-c\"><span class=\"pl-c\">--</span> Mark general truncate point</span>\n    { <span class=\"pl-smi\">hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>MiniStatuslineFilename<span class=\"pl-pds\">'</span></span>, <span class=\"pl-smi\">strings</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">filename</span> } },\n    <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%=<span class=\"pl-pds\">'</span></span>, <span class=\"pl-c\"><span class=\"pl-c\">--</span> End left alignment</span>\n    { <span class=\"pl-smi\">hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>MiniStatuslineFileinfo<span class=\"pl-pds\">'</span></span>, <span class=\"pl-smi\">strings</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">fileinfo</span> } },\n    { <span class=\"pl-smi\">hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">mode_hl</span>, <span class=\"pl-smi\">strings</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">search</span>, <span class=\"pl-smi\">location</span> } },\n  })\n<span class=\"pl-k\">end</span>\n<span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">'</span>mini.statusline<span class=\"pl-pds\">'</span></span>).<span class=\"pl-c1\">setup</span>({ <span class=\"pl-smi\">content</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">active</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">active_content</span> } })</pre></div>",
            "bodyText": "It is possible, yes. This requires writing custom section instead of using section_filename:\nlocal my_filename = function()\n  -- In terminal always use plain name\n  if vim.bo.buftype == 'terminal' then return '%t' end\n  local modified = vim.bo.modified and '❌' or '✅'\n  return (MiniStatusline.is_truncated(140) and '%f' or '%F') .. modified .. '%r'\nend\nYou can use it in combination with default active content like this:\nlocal active_content = function()\n  local mode, mode_hl = MiniStatusline.section_mode({ trunc_width = 120 })\n  local git = MiniStatusline.section_git({ trunc_width = 40 })\n  local diff = MiniStatusline.section_diff({ trunc_width = 75 })\n  local diagnostics = MiniStatusline.section_diagnostics({ trunc_width = 75 })\n  local lsp = MiniStatusline.section_lsp({ trunc_width = 75 })\n  local filename = my_filename()\n  local fileinfo = MiniStatusline.section_fileinfo({ trunc_width = 120 })\n  local location = MiniStatusline.section_location({ trunc_width = 75 })\n  local search = MiniStatusline.section_searchcount({ trunc_width = 75 })\n\n  return MiniStatusline.combine_groups({\n    { hl = mode_hl, strings = { mode } },\n    { hl = 'MiniStatuslineDevinfo', strings = { git, diff, diagnostics, lsp } },\n    '%<', -- Mark general truncate point\n    { hl = 'MiniStatuslineFilename', strings = { filename } },\n    '%=', -- End left alignment\n    { hl = 'MiniStatuslineFileinfo', strings = { fileinfo } },\n    { hl = mode_hl, strings = { search, location } },\n  })\nend\nrequire('mini.statusline').setup({ content = { active = active_content } })",
