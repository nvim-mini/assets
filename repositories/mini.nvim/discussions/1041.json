lass=\"pl-smi\">option</span> <span class=\"pl-k\">=</span> {\n        <span class=\"pl-en\">get_bufnrs</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n          <span class=\"pl-k\">return</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-c1\">tbl_map</span>(<span class=\"pl-k\">function</span>(<span class=\"pl-smi\">win</span>)\n            <span class=\"pl-k\">return</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_win_get_buf</span>(<span class=\"pl-smi\">win</span>)\n          <span class=\"pl-k\">end</span>, <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_list_wins</span>())\n        <span class=\"pl-k\">end</span>,\n      },\n    },\n  },\n  <span class=\"pl-smi\">mapping</span> <span class=\"pl-k\">=</span> {\n    [<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;c-space&gt;<span class=\"pl-pds\">\"</span></span>] <span class=\"pl-k\">=</span> <span class=\"pl-smi\">cmp</span>.<span class=\"pl-c1\">mapping</span>(<span class=\"pl-k\">function</span>()\n      <span class=\"pl-k\">if</span> <span class=\"pl-k\">not</span> <span class=\"pl-smi\">cmp</span>.<span class=\"pl-c1\">visible</span>() <span class=\"pl-k\">then</span>\n        <span class=\"pl-smi\">cmp</span>.<span class=\"pl-c1\">complete</span>()\n      <span class=\"pl-k\">end</span>\n      <span class=\"pl-smi\">cmp</span>.<span class=\"pl-c1\">abort</span>()\n    <span class=\"pl-k\">end</span>, { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>i<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>s<span class=\"pl-pds\">\" </span></span>}),\n    [<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;c-y&gt;<span class=\"pl-pds\">\"</span></span>] <span class=\"pl-k\">=</span> <span class=\"pl-smi\">cmp</span>.<span class=\"pl-c1\">mapping</span>(<span class=\"pl-k\">function</span>(<span class=\"pl-smi\">fall