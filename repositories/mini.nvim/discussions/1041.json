    "body": "I'm currently using my custom set of icons for `nvim-cmp`. Is it possible to use `mini.icons`? \r\n\r\nThis is my `nvim-cmp` config.\r\n\r\n```lua\r\nlocal icons = require \"core.icons\"\r\nlocal cmp = require \"cmp\"\r\nlocal luasnip = require \"luasnip\"\r\n\r\ncmp.setup {\r\n  snippet = {\r\n    expand = function(opts)\r\n      luasnip.lsp_expand(opts.body)\r\n    end,\r\n  },\r\n  experimental = {\r\n    ghost_text = true,\r\n  },\r\n  window = {\r\n    completion = {\r\n      scrolloff = vim.go.scrolloff,\r\n      border = \"rounded\",\r\n    },\r\n    documentation = {\r\n      border = \"rounded\",\r\n    },\r\n  },\r\n  formatting = {\r\n    fields = { \"kind\", \"abbr\", \"menu\" },\r\n    format = function(_, item)\r\n      local kind = item.kind\r\n      item.kind = icons.kind[kind]\r\n      item.menu = kind:gsub(\"(%l)(%u)\", \"%1 %2\"):lower()\r\n\r\n      return item\r\n    end,\r\n  },\r\n  sources = {\r\n    { name = \"path\", max_item_count = 20 },\r\n    {\r\n      name = \"nvim_lsp\",\r\n      max_item_count = 80,\r\n    },\r\n    {\r\n      name = \"buffer\",\r\n      max_item_count = 20,\r\n      option = {\r\n        get_bufnrs = function()\r\n          return vim.tbl_map(function(win)\r\n            return vim.api.nvim_win_get_buf(win)\r\n          end, vim.api.nvim_list_wins())\r\n        end,\r\n      },\r\n    },\r\n  },\r\n  mapping = {\r\n    [\"<c-space>\"] = cmp.mapping(function()\r\n      if not cmp.visible() then\r\n        cmp.complete()\r\n      end\r\n      cmp.abort()\r\n    end, { \"i\", \"s\" }),\r\n    [\"<c-y>\"] = cmp.mapping(function(fallback)\r\n      if not cmp.visible() then\r\n        fallback()\r\n      end\r\n      cmp.scroll_docs(-1)\r\n    end, { \"i\", \"s\" }),\r\n    [\"<c-e>\"] = cmp.mapping(function(fallback)\r\n      if not cmp.visible() then\r\n        fallback()\r\n      end\r\n      cmp.scroll_docs(1)\r\n    end, { \"i\", \"s\" }),\r\n    [\"<c-p>\"] = cmp.mapping(function(fallback)\r\n      if not cmp.visible() then\r\n        fallback()\r\n      end\r\n      cmp.select_prev_item()\r\n    end, { \"i\", \"s\" }),\r\n    [\"<c-n>\"] = cmp.mapping(function(fallback)\r\n      if not cmp.visible() then\r\n        fallback()\r\n      end\r\n      cmp.select_next_item()\r\n    end, { \"i\", \"s\" }),\r\n    [\"<cr>\"] = cmp.mapping(function(fallback)\r\n      if cmp.get_selected_entry() == nil then\r\n        fallback()\r\n      end\r\n      cmp.confirm()\r\n    end, { \"i\", \"s\" }),\r\n    [\"<s-tab>\"] = cmp.mapping(function(fallback)\r\n      if not luasnip.jumpable(-1) then\r\n        fallback()\r\n      end\r\n      luasnip.jump(-1)\r\n    end, { \"i\", \"s\" }),\r\n    [\"<tab>\"] = cmp.mapping(function(fallback)\r\n      if not luasnip.jumpable(1) then\r\n        fallback()\r\n      end\r\n      luasnip.jump(1)\r\n    end, { \"i\", \"s\" }),\r\n  },\r\n}\r\n```\r\n\r\n",
    "bodyHTML": "<p dir=\"auto\">I'm currently using my custom set of icons for <code class=\"notranslate\">nvim-cmp</code>. Is it possible to use <code class=\"notranslate\">mini.icons</code>?</p>\n<p dir=\"auto\">This is my <code class=\"notranslate\">nvim-cmp</code> config.</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"local icons = require &quot;core.icons&quot;\nlocal cmp = require &quot;cmp&quot;\nlocal luasnip = require &quot;luasnip&quot;\n\ncmp.setup {\n  snippet = {\n    expand = function(opts)\n      luasnip.lsp_expand(opts.body)\n    end,\n  },\n  experimental = {\n    ghost_text = true,\n  },\n  window = {\n    completion = {\n      scrolloff = vim.go.scrolloff,\n      border = &quot;rounded&quot;,\n    },\n    documentation = {\n      border = &quot;rounded&quot;,\n    },\n  },\n  formatting = {\n    fields = { &quot;kind&quot;, &quot;abbr&quot;, &quot;menu&quot; },\n    format = function(_, item)\n      local kind = item.kind\n      item.kind = icons.kind[kind]\n      item.menu = kind:gsub(&quot;(%l)(%u)&quot;, &quot;%1 %2&quot;):lower()\n\n      return item\n    end,\n  },\n  sources = {\n    { name = &quot;path&quot;, max_item_count = 20 },\n    {\n      name = &quot;nvim_lsp&quot;,\n      max_item_count = 80,\n    },\n    {\n      name = &quot;buffer&quot;,\n      max_item_count = 20,\n      option = {\n        get_bufnrs = function()\n          return vim.tbl_map(function(win)\n            return vim.api.nvim_win_get_buf(win)\n          end, vim.api.nvim_list_wins())\n        end,\n      },\n    },\n  },\n  mapping = {\n    [&quot;&lt;c-space&gt;&quot;] = cmp.mapping(function()\n      if not cmp.visible() then\n        cmp.complete()\n      end\n      cmp.abort()\n    end, { &quot;i&quot;, &quot;s&quot; }),\n    [&quot;&lt;c-y&gt;&quot;] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.scroll_docs(-1)\n    end, { &quot;i&quot;, &quot;s&quot; }),\n    [&quot;&lt;c-e&gt;&quot;] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.scroll_docs(1)\n    end, { &quot;i&quot;, &quot;s&quot; }),\n    [&quot;&lt;c-p&gt;&quot;] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.select_prev_item()\n    end, { &quot;i&quot;, &quot;s&quot; }),\n    [&quot;&lt;c-n&gt;&quot;] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.select_next_item()\n    end, { &quot;i&quot;, &quot;s&quot; }),\n    [&quot;&lt;cr&gt;&quot;] = cmp.mapping(function(fallback)\n      if cmp.get_selected_entry() == nil then\n        fallback()\n      end\n      cmp.confirm()\n    end, { &quot;i&quot;, &quot;s&quot; }),\n    [&quot;&lt;s-tab&gt;&quot;] = cmp.mapping(function(fallback)\n      if not luasnip.jumpable(-1) then\n        fallback()\n      end\n      luasnip.jump(-1)\n    end, { &quot;i&quot;, &quot;s&quot; }),\n    [&quot;&lt;tab&gt;&quot;] = cmp.mapping(function(fallback)\n      if not luasnip.jumpable(1) then\n        fallback()\n      end\n      luasnip.jump(1)\n    end, { &quot;i&quot;, &quot;s&quot; }),\n  },\n}\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-smi\">icons</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>core.icons<span class=\"pl-pds\">\"</span></span>\n<span class=\"pl-k\">local</span> <span class=\"pl-smi\">cmp</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>cmp<span class=\"pl-pds\">\"</span></span>\n<span class=\"pl-k\">local</span> <span class=\"pl-smi\">luasnip</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>luasnip<span class=\"