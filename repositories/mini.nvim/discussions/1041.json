k\">end</span>, { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>i<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>s<span class=\"pl-pds\">\" </span></span>}),\n    [<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;s-tab&gt;<span class=\"pl-pds\">\"</span></span>] <span class=\"pl-k\">=</span> <span class=\"pl-smi\">cmp</span>.<span class=\"pl-c1\">mapping</span>(<span class=\"pl-k\">function</span>(<span class=\"pl-smi\">fallback</span>)\n      <span class=\"pl-k\">if</span> <span class=\"pl-k\">not</span> <span class=\"pl-smi\">luasnip</span>.<span class=\"pl-c1\">jumpable</span>(<span class=\"pl-k\">-</span><span class=\"pl-c1\">1</span>) <span class=\"pl-k\">then</span>\n        <span class=\"pl-c1\">fallback</span>()\n      <span class=\"pl-k\">end</span>\n      <span class=\"pl-smi\">luasnip</span>.<span class=\"pl-c1\">jump</span>(<span class=\"pl-k\">-</span><span class=\"pl-c1\">1</span>)\n    <span class=\"pl-k\">end</span>, { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>i<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>s<span class=\"pl-pds\">\" </span></span>}),\n    [<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;tab&gt;<span class=\"pl-pds\">\"</span></span>] <span class=\"pl-k\">=</span> <span class=\"pl-smi\">cmp</span>.<span class=\"pl-c1\">mapping</span>(<span class=\"pl-k\">function</span>(<span class=\"pl-smi\">fallback</span>)\n      <span class=\"pl-k\">if</span> <span class=\"pl-k\">not</span> <span class=\"pl-smi\">luasnip</span>.<span class=\"pl-c1\">jumpable</span>(<span class=\"pl-c1\">1</span>) <span class=\"pl-k\">then</span>\n        <span class=\"pl-c1\">fallback</span>()\n      <span class=\"pl-k\">end</span>\n      <span class=\"pl-smi\">luasnip</span>.<span class=\"pl-c1\">jump</span>(<span class=\"pl-c1\">1</span>)\n    <span class=\"pl-k\">end</span>, { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>i<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>s<span class=\"pl-pds\">\" </span></span>}),\n  },\n}</pre></div>",
    "bodyText": "I'm currently using my custom set of icons for nvim-cmp. Is it possible to use mini.icons?\nThis is my nvim-cmp config.\nlocal icons = require \"core.icons\"\nlocal cmp = require \"cmp\"\nlocal luasnip = require \"luasnip\"\n\ncmp.setup {\n  snippet = {\n    expand = function(opts)\n      luasnip.lsp_expand(opts.body)\n    end,\n  },\n  experimental = {\n    ghost_text = true,\n  },\n  window = {\n    completion = {\n      scrolloff = vim.go.scrolloff,\n      border = \"rounded\",\n    },\n    documentation = {\n      border = \"rounded\",\n    },\n  },\n  formatting = {\n    fields = { \"kind\", \"abbr\", \"menu\" },\n    format = function(_, item)\n      local kind = item.kind\n      item.kind = icons.kind[kind]\n      item.menu = kind:gsub(\"(%l)(%u)\", \"%1 %2\"):lower()\n\n      return item\n    end,\n  },\n  sources = {\n    { name = \"path\", max_item_count = 20 },\n    {\n      name = \"nvim_lsp\",\n      max_item_count = 80,\n    },\n    {\n      name = \"buffer\",\n      max_item_count = 20,\n      option = {\n        get_bufnrs = function()\n          return vim.tbl_map(function(win)\n            return vim.api.nvim_win_get_buf(win)\n          end, vim.api.nvim_list_wins())\n        end,\n      },\n    },\n  },\n  mapping = {\n    [\"<c-space>\"] = cmp.mapping(function()\n      if not cmp.visible() then\n        cmp.complete()\n      end\n      cmp.abort()\n    end, { \"i\", \"s\" }),\n    [\"<c-y>\"] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.scroll_docs(-1)\n    end, { \"i\", \"s\" }),\n    [\"<c-e>\"] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.scroll_docs(1)\n    end, { \"i\", \"s\" }),\n    [\"<c-p>\"] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.select_prev_item()\n    end, { \"i\", \"s\" }),\n    [\"<c-n>\"] = cmp.mapping(function(fallback)\n      if not cmp.visible() then\n        fallback()\n      end\n      cmp.select_next_item()\n    end, { \"i\", \"s\" }),\n    [\"<cr>\"] = cmp.mapping(function(fallback)\n      if cmp.get_selected_entry() == nil then\n        fallback()\n      end\n      cmp.confirm()\n    end, { \"i\", \"s\" }),\n    [\"<s-tab>\"] = cmp.mapping(function(fallback)\n      if not luasnip.jumpable(-1) then\n        fallback()\n      end\n      luasnip.jump(-1)\n    end, { \"i\", \"s\" }),\n    [\"<tab>\"] = cmp.mapping(function(fallback)\n      if not luasnip.jumpable(1) then\n        fallback()\n      end\n      luasnip.jump(1)\n    end, { \"i\", \"s\" }),\n  },\n}",
