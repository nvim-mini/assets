    "closedAt": "2025-09-28T11:35:34Z",
    "comment_count": 1,
    "comment_data": [
        {
            "author": {
                "avatarUrl": "https://avatars.githubusercontent.com/u/119845045?u=9e2489487d1e983158fa9026e290027a273bd2be&v=4",
                "login": "drowning-cat",
                "resourcePath": "/drowning-cat",
                "url": "https://github.com/drowning-cat"
            },
            "authorAssociation": "CONTRIBUTOR",
            "body": "It can be done in user-space configuration, but it is not an ideal solution:\r\n\r\n```lua\r\nvim.keymap.set(\"n\", \"<Leader>w\", \"<C-w>\", { desc = \"+Window\" })\r\n\r\nlocal windows_clue = function(trigger, opts)\r\n  local clues = MiniClue.gen_clues.windows(opts)\r\n  if trigger then\r\n    for _, clue in ipairs(clues) do\r\n      clue.keys = string.gsub(clue.keys, \"^<C%-w>\", trigger)\r\n    end\r\n  end\r\n  return clues\r\nend\r\n\r\nlocal MiniClue = require(\"mini.clue\")\r\nMiniClue.setup({\r\n  triggers = {\r\n    { mode = \"n\", keys = \"<C-w>\" },\r\n    { mode = \"n\", keys = \"<Leader>w\" },\r\n  },\r\n  clues = {\r\n    windows_clue(),\r\n    windows_clue(\"<Leader>w\"),\r\n  },\r\n})\r\n```",
            "bodyHTML": "<p dir=\"auto\">It can be done in user-space configuration, but it is not an ideal solution:</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"vim.keymap.set(&quot;n&quot;, &quot;&lt;Leader&gt;w&quot;, &quot;&lt;C-w&gt;&quot;, { desc = &quot;+Window&quot; })\n\nlocal windows_clue = function(trigger, opts)\n  local clues = MiniClue.gen_clues.windows(opts)\n  if trigger then\n    for _, clue in ipairs(clues) do\n      clue.keys = string.gsub(clue.keys, &quot;^&lt;C%-w&gt;&quot;, trigger)\n    end\n  end\n  return clues\nend\n\nlocal MiniClue = require(&quot;mini.clue&quot;)\nMiniClue.setup({\n  triggers = {\n    { mode = &quot;n&quot;, keys = &quot;&lt;C-w&gt;&quot; },\n    { mode = &quot;n&quot;, keys = &quot;&lt;Leader&gt;w&quot; },\n  },\n  clues = {\n    windows_clue(),\n    windows_clue(&quot;&lt;Leader&gt;w&quot;),\n  },\n})\"><pre class=\"notranslate\"><span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">keymap</span>.<span class=\"pl-c1\">set</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;Leader&gt;w<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;C-w&gt;<span class=\"pl-pds\">\"</span></span>, { <span class=\"pl-smi\">desc</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>+Window<span class=\"pl-pds\">\" </span></span>})\n\n<span class=\"pl-k\">local</span> <span class=\"pl-en\">windows_clue</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>(<span class=\"pl-smi\">trigger</span>, <span class=\"pl-smi\">opts</span>)\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">clues</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniClue</span>.<span class=\"pl-e\">gen_clues</span>.<span class=\"pl-c1\">windows</span>(<span class=\"pl-smi\">opts</span>)\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">trigger</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-k\">for</span> <span class=\"pl-smi\">_</span>, <span class=\"pl-smi\">clue</span> <span class=\"pl-k\">in</span> <span class=\"pl-c1\">ipairs</span>(<span class=\"pl-smi\">clues</span>) <span class=\"pl-k\">do</span>\n      <span class=\"pl-smi\">clue</span>.<span class=\"pl-e\">keys</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">string.gsub</span>(<span class=\"pl-smi\">clue</span>.<span class=\"pl-e\">keys</span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>^&lt;C%-w&gt;<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">trigger</span>)\n    <span class=\"pl-k\">end</span>\n  <span class=\"pl-k\">end</span>\n  <span class=\"pl-k\">return</span> <span class=\"pl-smi\">clues</span>\n<span class=\"pl-k\">end</span>\n\n<span class=\"pl-k\">local</span> <span class=\"pl-smi\">MiniClue</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.clue<span class=\"pl-pds\">\"</span></span>)\n<span class=\"pl-smi\">MiniClue</span>.<span class=\"pl-c1\">setup</span>({\n  <span class=\"pl-smi\">triggers</span> <span class=\"pl-k\">=</span> {\n    { <span class=\"pl-smi\">mode</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">keys</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;C-w&gt;<span class=\"pl-pds\">\" </span></span>},\n    { <span class=\"pl-smi\">mode</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">keys</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;Leader&gt;w<span class=\"pl-pds\">\" </span></span>},\n  },\n  <span class=\"pl-smi\">clues</span> <span class=\"pl-k\">=</span> {\n    <span class=\"pl-c1\">windows_clue</span>(),\n    <span class=\"pl-c1\">windows_clue</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;Leader&gt;w<span class=\"pl-pds\">\"</span></span>),\n  },\n})</pre></div>",
            "bodyText": "It can be done in user-space configuration, but it is not an ideal solution:\nvim.keymap.set(\"n\", \"<Leader>w\", \"<C-w>\", { desc = \"+Window\" })\n\nlocal windows_clue = function(trigger, opts)\n  local clues = MiniClue.gen_clues.windows(opts)\n  if trigger then\n    for _, clue in ipairs(clues) do\n      clue.keys = string.gsub(clue.keys, \"^<C%-w>\", trigger)\n    end\n  end\n  return clues\nend\n\nlocal MiniClue = require(\"mini.clue\")\nMiniClue.setup({\n  triggers = {\n    { mode = \"n\", keys = \"<C-w>\" },\n    { mode = \"n\", keys = \"<Leader>w\" },\n  },\n  clues = {\n    windows_clue(),\n    windows_clue(\"<Leader>w\"),\n  },\n})",
