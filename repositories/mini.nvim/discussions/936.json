                {
                    "author": {
                        "avatarUrl": "https://avatars.githubusercontent.com/u/119845045?u=9e2489487d1e983158fa9026e290027a273bd2be&v=4",
                        "login": "drowning-cat",
                        "resourcePath": "/drowning-cat",
                        "url": "https://github.com/drowning-cat"
                    },
                    "authorAssociation": "CONTRIBUTOR",
                    "body": "See https://github.com/nvim-mini/mini.nvim/discussions/2238\r\n\r\n```lua\r\nlocal toggle_preview = function()\r\n  local is_enabled = MiniFiles.config.windows.preview\r\n  local enable = not is_enabled\r\n  MiniFiles.config.windows.preview = enable\r\n  MiniFiles.trim_right()\r\n  MiniFiles.refresh({ windows = { preview = enable } })\r\n  MiniFiles.refresh()\r\n  if is_enabled then\r\n    local branch = MiniFiles.get_explorer_state().branch\r\n    table.remove(branch)\r\n    MiniFiles.set_branch(branch)\r\n  end\r\nend\r\n\r\nvim.api.nvim_create_autocmd(\"User\", {\r\n  pattern = \"MiniFilesBufferCreate\",\r\n  group = vim.api.nvim_create_augroup(\"minifiles.keymaps\", { clear = true }),\r\n  callback = function(args)\r\n    local buf = args.data.buf_id\r\n    vim.keymap.set(\"n\", \"<M-p>\", toggle_preview, { buffer = buf, desc = \"Toggle preview\" })\r\n  end,\r\n})\r\n```",
                    "bodyHTML": "<p dir=\"auto\">See <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"9376013\" data-permission-text=\"Title is private\" data-url=\"https://github.com/nvim-mini/mini.nvim/discussions/2238\" data-hovercard-type=\"discussion\" data-hovercard-url=\"/nvim-mini/mini.nvim/discussions/2238/hovercard\" href=\"https://github.com/nvim-mini/mini.nvim/discussions/2238\">#2238</a></p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"local toggle_preview = function()\n  local is_enabled = MiniFiles.config.windows.preview\n  local enable = not is_enabled\n  MiniFiles.config.windows.preview = enable\n  MiniFiles.trim_right()\n  MiniFiles.refresh({ windows = { preview = enable } })\n  MiniFiles.refresh()\n  if is_enabled then\n    local branch = MiniFiles.get_explorer_state().branch\n    table.remove(branch)\n    MiniFiles.set_branch(branch)\n  end\nend\n\nvim.api.nvim_create_autocmd(&quot;User&quot;, {\n  pattern = &quot;MiniFilesBufferCreate&quot;,\n  group = vim.api.nvim_create_augroup(&quot;minifiles.keymaps&quot;, { clear = true }),\n  callback = function(args)\n    local buf = args.data.buf_id\n    vim.keymap.set(&quot;n&quot;, &quot;&lt;M-p&gt;&quot;, toggle_preview, { buffer = buf, desc = &quot;Toggle preview&quot; })\n  end,\n})\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-en\">toggle_preview</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">is_enabled</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-e\">config</span>.<span class=\"pl-e\">windows</span>.<span class=\"pl-e\">preview</span>\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">enable</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">not</span> <span class=\"pl-smi\">is_enabled</span>\n  <span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-e\">config</span>.<span class=\"pl-e\">windows</span>.<span class=\"pl-e\">preview</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">enable</span>\n  <span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-c1\">trim_right</span>()\n  <span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-c1\">refresh</span>({ <span class=\"pl-smi\">windows</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">preview</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">enable</span> } })\n  <span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-c1\">refresh</span>()\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">is_enabled</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">branch</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-c1\">get_explorer_state</span>().<span class=\"pl-e\">branch</span>\n    <span class=\"pl-c1\">table.remove</span>(<span class=\"pl-smi\">branch</span>)\n    <span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-c1\">set_branch</span>(<span class=\"pl-smi\">branch</span>)\n  <span class=\"pl-k\">end</span>\n<span class=\"pl-k\">end</span>\n\n<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_autocmd</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>User<span class=\"pl-pds\">\"</span></span>, {\n  <span class=\"pl-smi\">pattern</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>MiniFilesBufferCreate<span class=\"pl-pds\">\"</span></span>,\n  <span class=\"pl-smi\">group</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_augroup</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>minifiles.keymaps<span class=\"pl-pds\">\"</span></span>, { <span class=\"pl-smi\">clear</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">true</span> }),\n  <span class=\"pl-en\">callback</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>(<span class=\"pl-smi\">args</span>)\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">buf</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">args</span>.<span class=\"pl-e\">data</span>.<span class=\"pl-e\">buf_id</span>\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">keymap</span>.<span class=\"pl-c1\">set</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;M-p&gt;<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">toggle_preview</span>, { <span class=\"pl-smi\">buffer</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">buf</span>, <span class=\"pl-smi\">desc</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Toggle preview<span class=\"pl-pds\">\" </span></span>})\n  <span class=\"pl-k\">end</span>,\n})</pre></div>",
                    "bodyText": "See #2238\nlocal toggle_preview = function()\n  local is_enabled = MiniFiles.config.windows.preview\n  local enable = not is_enabled\n  MiniFiles.config.windows.preview = enable\n  MiniFiles.trim_right()\n  MiniFiles.refresh({ windows = { preview = enable } })\n  MiniFiles.refresh()\n  if is_enabled then\n    local branch = MiniFiles.get_explorer_state().branch\n    table.remove(branch)\n    MiniFiles.set_branch(branch)\n  end\nend\n\nvim.api.nvim_create_autocmd(\"User\", {\n  pattern = \"MiniFilesBufferCreate\",\n  group = vim.api.nvim_create_augroup(\"minifiles.keymaps\", { clear = true }),\n  callback = function(args)\n    local buf = args.data.buf_id\n    vim.keymap.set(\"n\", \"<M-p>\", toggle_preview, { buffer = buf, desc = \"Toggle preview\" })\n  end,\n})",
