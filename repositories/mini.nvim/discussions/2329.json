n>(<span class=\"pl-smi\">char</span>, <span class=\"pl-smi\">data</span>) </td>\n        </tr>\n\n        <tr class=\"border-0\">\n          <td id=\"L2557\" class=\"blob-num border-0 tmp-px-3 py-0 color-bg-default\" data-line-number=\"2557\"></td>\n          <td id=\"LC2557\" class=\"blob-code border-0 tmp-px-3 py-0 color-bg-default blob-code-inner js-file-line\">     <span class=\"pl-c1\">add_to_res</span>(<span class=\"pl-smi\">alt_chars</span>[<span class=\"pl-smi\">name</span>], <span class=\"pl-smi\">data</span>) </td>\n        </tr>\n\n        <tr class=\"border-0\">\n          <td id=\"L2558\" class=\"blob-num border-0 tmp-px-3 py-0 color-bg-default\" data-line-number=\"2558\"></td>\n          <td id=\"LC2558\" class=\"blob-code border-0 tmp-px-3 py-0 color-bg-default blob-code-inner js-file-line\">   <span class=\"pl-k\">end</span> </td>\n        </tr>\n\n        <tr class=\"border-0\">\n          <td id=\"L2559\" class=\"blob-num border-0 tmp-px-3 py-0 color-bg-default\" data-line-number=\"2559\"></td>\n          <td id=\"LC2559\" class=\"blob-code border-0 tmp-px-3 py-0 color-bg-default blob-code-inner js-file-line\">  </td>\n        </tr>\n\n        <tr class=\"border-0\">\n          <td id=\"L2560\" class=\"blob-num border-0 tmp-px-3 py-0 color-bg-default\" data-line-number=\"2560\"></td>\n          <td id=\"LC2560\" class=\"blob-code border-0 tmp-px-3 py-0 color-bg-default blob-code-inner js-file-line\">   <span class=\"pl-k\">return</span> <span class=\"pl-smi\">res</span> </td>\n        </tr>\n\n        <tr class=\"border-0\">\n          <td id=\"L2561\" class=\"blob-num border-0 tmp-px-3 py-0 color-bg-default\" data-line-number=\"2561\"></td>\n          <td id=\"LC2561\" class=\"blob-code border-0 tmp-px-3 py-0 color-bg-default blob-code-inner js-file-line\"> <span class=\"pl-k\">end</span> </td>\n        </tr>\n    </tbody></table>\n  </div>\n</div>\n<p></p>\n<p dir=\"auto\">P.S. Not sure why I didn't create an issue, maybe the weather's just too nice.</p>",
    "bodyText": "Contributing guidelines\n\n I have read CODE_OF_CONDUCT.md\n\nModule(s)\nmini.pick\nQuestion\nWarning (mini.pick) Duplicating mapping keys: caret_start and move_start for the code (after 3b1b65e):\nvim.pack.add({\n  { src = \"https://github.com/nvim-mini/mini.nvim\" },\n})\n\nvim.keymap.set(\"n\", \"<Space>R\", \"<Cmd>restart<CR>\")\nvim.keymap.set(\"n\", \"<Space>f\", \"<Cmd>Pick files<CR>\")\n\nrequire(\"mini.pick\").setup({\n  mappings = {\n    caret_start = { char = \"<Home>\", func = function() end },\n  },\n})\nBy default, move_start = <C-g> also sets alt_chars = { move_start = \"<Home>\" }. This causes a warning when the <Home> key is defined.\nThere's currently no way to disable alt_chars, so they probably need to be ignored for the warning. Alternatively, alt keys could be defined directly in the mappings, for example: move_start_alt = \"<Home>\".\n\n  \n    \n      mini.nvim/lua/mini/pick.lua\n    \n    \n        Lines 2537 to 2561\n      in\n      59f0994\n    \n  \n  \n    \n\n        \n          \n           H.normalize_mappings = function(mappings, skip_alternatives) \n        \n\n        \n          \n             local res = {} \n        \n\n        \n          \n             local add_to_res = function(char, data) \n        \n\n        \n          \n               local key = H.replace_termcodes(char) \n        \n\n        \n          \n               -- Omit disabled keys and prefer custom actions over built-ins \n        \n\n        \n          \n               if (key == nil or key == '') or (res[key] ~= nil and res[key].is_custom) then return end \n        \n\n        \n          \n               if res[key] ~= nil then H.notify('Duplicating mapping keys: ' .. data.name .. ' and ' .. res[key].name, 'WARN') end \n        \n\n        \n          \n               res[key] = data \n        \n\n        \n          \n             end \n        \n\n        \n          \n            \n        \n\n        \n          \n             -- Use alternative keys for some common actions \n        \n\n        \n          \n             local alt_chars = {} \n        \n\n        \n          \n             if not skip_alternatives then alt_chars = { move_down = '<Down>', move_start = '<Home>', move_up = '<Up>' } end \n        \n\n        \n          \n            \n        \n\n        \n          \n             -- Process \n        \n\n        \n          \n             for name, rhs in pairs(mappings) do \n        \n\n        \n          \n               local is_custom = type(rhs) == 'table' \n        \n\n        \n          \n               local char = is_custom and rhs.char or rhs \n        \n\n        \n          \n               local data = { char = char, name = name, func = is_custom and rhs.func or H.actions[name], is_custom = is_custom } \n        \n\n        \n          \n               add_to_res(char, data) \n        \n\n        \n          \n               add_to_res(alt_chars[name], data) \n        \n\n        \n          \n             end \n        \n\n        \n          \n            \n        \n\n        \n          \n             return res \n        \n\n        \n          \n           end \n        \n    \n  \n\n\nP.S. Not sure why I didn't create an issue, maybe the weather's just too nice.",
