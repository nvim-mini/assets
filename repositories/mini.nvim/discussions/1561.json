l-smi\">ai</span>.<span class=\"pl-e\">gen_spec</span>.<span class=\"pl-c1\">treesitter</span>({\n          <span class=\"pl-smi\">a</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>@function.outer<span class=\"pl-pds\">\"</span></span>,\n          <span class=\"pl-smi\">i</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>@function.inner<span class=\"pl-pds\">\"</span></span>,\n        }),\n        <span class=\"pl-smi\">c</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">ai</span>.<span class=\"pl-e\">gen_spec</span>.<span class=\"pl-c1\">treesitter</span>({\n          <span class=\"pl-smi\">a</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>@class.outer<span class=\"pl-pds\">\"</span></span>,\n          <span class=\"pl-smi\">i</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>@class.inner<span class=\"pl-pds\">\"</span></span>,\n        }),\n        <span class=\"pl-smi\">t</span> <span class=\"pl-k\">=</span> { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>&lt;([%p%w]-)%f[^&lt;%w][^&lt;&gt;]-&gt;.-&lt;/%1&gt;<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>^&lt;.-&gt;().*()&lt;/[^/]-&gt;$<span class=\"pl-pds\">\" </span></span>},\n        <span class=\"pl-smi\">d</span> <span class=\"pl-k\">=</span> { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>%f[%d]%d+<span class=\"pl-pds\">\" </span></span>}, <span class=\"pl-c\"><span class=\"pl-c\">--</span> digits</span>\n        <span class=\"pl-smi\">e</span> <span class=\"pl-k\">=</span> { <span class=\"pl-c\"><span class=\"pl-c\">--</span> Word with case</span>\n          {\n            <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>%u[%l%d]+%f[^%l%d]<span class=\"pl-pds\">\"</span></span>,\n            <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>%f[%S][%l%d]+%f[^%l%d]<span class=\"pl-pds\">\"</span></span>,\n            <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>%f[%P][%l%d]+%f[^%l%d]<span class=\"pl-pds\">\"</span></span>,\n            <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>^[%l%d]+%f[^%l%d]<span class=\"pl-pds\">\"</span></span>,\n          },\n          <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>^().*()$<span class=\"pl-pds\">\"</span></span>,\n        },\n        <span class=\"pl-smi\">u</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">ai</span>.<span class=\"pl-e\">gen_spec</span>.<span class=\"pl-c1\">function_call</span>(), <span class=\"pl-c\"><span class=\"pl-c\">--</span> u for \"Usage\"</span>\n        <span class=\"pl-smi\">U</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">ai</span>.<span class=\"pl-e\">gen_spec</span>.<span class=\"pl-c1\">function_call</span>({ <span class=\"pl-smi\">name_pattern</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>[%w_]<span class=\"pl-pds\">\" </span></span>}), <span class=\"pl-c\"><span class=\"pl-c\">--</span> without dot in function name</span>\n      },\n    }\n  <span class=\"pl-k\">end</span>,\n}</pre></div>",
            "bodyText": "Now that i went back to this, all custom text objects with treesitter arent working.\nmy full config\nreturn {\n  \"echasnovski/mini.ai\",\n  event = \"VeryLazy\",\n  dependencies = { \"nvim-treesitter/nvim-treesitter\" },\n  opts = function()\n    local ai = require(\"mini.ai\")\n    return {\n      n_lines = 500,\n      custom_textobjects = {\n        o = ai.gen_spec.treesitter({\n          a = { \"@block.outer\", \"@conditional.outer\", \"@loop.outer\" },\n          i = { \"@block.inner\", \"@conditional.inner\", \"@loop.inner\" },\n        }),\n        f = ai.gen_spec.treesitter({\n          a = \"@function.outer\",\n          i = \"@function.inner\",\n        }),\n        c = ai.gen_spec.treesitter({\n          a = \"@class.outer\",\n          i = \"@class.inner\",\n        }),\n        t = { \"<([%p%w]-)%f[^<%w][^<>]->.-</%1>\", \"^<.->().*()</[^/]->$\" },\n        d = { \"%f[%d]%d+\" }, -- digits\n        e = { -- Word with case\n          {\n            \"%u[%l%d]+%f[^%l%d]\",\n            \"%f[%S][%l%d]+%f[^%l%d]\",\n            \"%f[%P][%l%d]+%f[^%l%d]\",\n            \"^[%l%d]+%f[^%l%d]\",\n          },\n          \"^().*()$\",\n        },\n        u = ai.gen_spec.function_call(), -- u for \"Usage\"\n        U = ai.gen_spec.function_call({ name_pattern = \"[%w_]\" }), -- without dot in function name\n      },\n    }\n  end,\n}",
