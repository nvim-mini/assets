                    "body": "You're right, thanks for pointing to the docs. I'm happy with this config:\r\n\r\n```lua\r\n-- MiniFiles mappings for working with the entry under the cursor.\r\nlocal mini_files_mappings = vim.api.nvim_create_augroup(\"mini_files_mappings\", { clear = true })\r\n\r\n---@diagnostic disable: undefined-global\r\nlocal get_mini_files_path = function()\r\n  local path = (MiniFiles.get_fs_entry() or {}).path\r\n  if path == nil then\r\n    vim.notify(\"Cursor is not on valid entry\")\r\n    return nil\r\n  end\r\n  return path\r\nend\r\n\r\nlocal set_cwd = function()\r\n  local path = get_mini_files_path()\r\n  if path == nil then\r\n    return\r\n  end\r\n  vim.fn.chdir(vim.fs.dirname(path))\r\nend\r\n\r\nlocal yank_absolute_path = function()\r\n  local path = get_mini_files_path()\r\n  if path == nil then\r\n    return\r\n  end\r\n  vim.fn.setreg(vim.v.register, path)\r\nend\r\n\r\nlocal yank_relative_path = function()\r\n  local path = get_mini_files_path()\r\n  if path == nil then\r\n    return\r\n  end\r\n\r\n  local root = require(\"lazyvim.util\").root({ normalize = true })\r\n  local normalized_path = vim.fs.normalize(path)\r\n\r\n  if normalized_path == root then\r\n    vim.fn.setreg(vim.v.register, \".\")\r\n    return\r\n  end\r\n\r\n  local root_prefix = root .. \"/\"\r\n  if normalized_path:sub(1, #root_prefix) ~= root_prefix then\r\n    vim.notify(\"Entry is not under the project root\")\r\n    return\r\n  end\r\n\r\n  vim.fn.setreg(vim.v.register, normalized_path:sub(#root_prefix + 1))\r\nend\r\n\r\nlocal ui_open = function()\r\n  local path = get_mini_files_path()\r\n  if path == nil then\r\n    return\r\n  end\r\n  vim.ui.open(path)\r\nend\r\n---@diagnostic enable: undefined-global\r\n\r\nvim.api.nvim_create_autocmd(\"User\", {\r\n  group = mini_files_mappings,\r\n  pattern = \"MiniFilesBufferCreate\",\r\n  callback = function(args)\r\n    local b = args.data.buf_id\r\n    vim.keymap.set(\"n\", \"g~\", set_cwd, { buffer = b, desc = \"Set cwd\" })\r\n    vim.keymap.set(\"n\", \"gX\", ui_open, { buffer = b, desc = \"open with default app\" })\r\n    vim.keymap.set(\"n\", \"gy\", yank_relative_path, { buffer = b, desc = \"Yank relative path\" })\r\n    vim.keymap.set(\"n\", \"gY\", yank_absolute_path, { buffer = b, desc = \"Yank absolute path\" })\r\n  end,\r\n})\r\n```",
                    "bodyHTML": "<p dir=\"auto\">You're right, thanks for pointing to the docs. I'm happy with this config:</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"-- MiniFiles mappings for working with the entry under the cursor.\nlocal mini_files_mappings = vim.api.nvim_create_augroup(&quot;mini_files_mappings&quot;, { clear = true })\n\n---@diagnostic disable: undefined-global\nlocal get_mini_files_path = function()\n  local path = (MiniFiles.get_fs_entry() or {}).path\n  if path == nil then\n    vim.notify(&quot;Cursor is not on valid entry&quot;)\n    return nil\n  end\n  return path\nend\n\nlocal set_cwd = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n  vim.fn.chdir(vim.fs.dirname(path))\nend\n\nlocal yank_absolute_path = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n  vim.fn.setreg(vim.v.register, path)\nend\n\nlocal yank_relative_path = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n\n  local root = require(&quot;lazyvim.util&quot;).root({ normalize = true })\n  local normalized_path = vim.fs.normalize(path)\n\n  if normalized_path == root then\n    vim.fn.setreg(vim.v.register, &quot;.&quot;)\n    return\n  end\n\n  local root_prefix = root .. &quot;/&quot;\n  if normalized_path:sub(1, #root_prefix) ~= root_prefix then\n    vim.notify(&quot;Entry is not under the project root&quot;)\n    return\n  end\n\n  vim.fn.setreg(vim.v.register, normalized_path:sub(#root_prefix + 1))\nend\n\nlocal ui_open = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n  vim.ui.open(path)\nend\n---@diagnostic enable: undefined-global\n\nvim.api.nvim_create_autocmd(&quot;User&quot;, {\n  group = mini_files_mappings,\n  pattern = &quot;MiniFilesBufferCreate&quot;,\n  callback = function(args)\n    local b = args.data.buf_id\n    vim.keymap.set(&quot;n&quot;, &quot;g~&quot;, set_cwd, { buffer = b, desc = &quot;Set cwd&quot; })\n    vim.keymap.set(&quot;n&quot;, &quot;gX&quot;, ui_open, { buffer = b, desc = &quot;open with default app&quot; })\n    vim.keymap.set(&quot;n&quot;, &quot;gy&quot;, yank_relative_path, { buffer = b, desc = &quot;Yank relative path&quot; })\n    vim.keymap.set(&quot;n&quot;, &quot;gY&quot;, yank_absolute_path, { buffer = b, desc = &quot;Yank absolute path&quot; })\n  end,\n})\"><pre class=\"notranslate\"><span class=\"pl-c\"><span class=\"pl-c\">--</span> MiniFiles mappings for working with the entry under the cursor.</span>\n<span class=\"pl-k\">local</span> <span class=\"pl-smi\">mini_files_mappings</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_augroup</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini_files_mappings<span class=\"pl-pds\">\"</span></span>, { <span class=\"pl-smi\">clear</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">true</span> })\n\n<span class=\"pl-c\"><span class=\"pl-c\">---</span><span class=\"pl-k\">@diagnostic</span> <span class=\"pl-k\">disable</span><span class=\"pl-k\">:</span> <span class=\"pl-c1\">undefined-global</span></span>\n<span class=\"pl-k\">local</span> <span class=\"pl-en\">get_mini_files_path</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">=</span> (<span class=\"pl-smi\">MiniFiles</span>.<span class=\"pl-c1\">get_fs_entry</span>() <span class=\"pl-k\">or</span> {}).<span class=\"pl-e\">path</span>\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">==</span> <span class=\"pl-c1\">nil</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-c1\">notify</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Cursor is not on valid entry<span class=\"pl-pds\">\"</span></span>)\n    <span class=\"pl-k\">return</span> <span class=\"pl-c1\">nil</span>\n  <span class=\"pl-k\">end</span>\n  <span class=\"pl-k\">return</span> <span class=\"pl-smi\">path</span>\n<span class=\"pl-k\">end</span>\n\n<span class=\"pl-k\">local</span> <span class=\"pl-en\">set_cwd</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">get_mini_files_path</span>()\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">==</span> <span class=\"pl-c1\">nil</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-k\">return</span>\n  <span class=\"pl-k\">end</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fn</span>.<span class=\"pl-c1\">chdir</span>(<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fs</span>.<span class=\"pl-c1\">dirname</span>(<span class=\"pl-smi\">path</span>))\n<span class=\"pl-k\">end</span>\n\n<span class=\"pl-k\">local</span> <span class=\"pl-en\">yank_absolute_path</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">get_mini_files_path</span>()\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">==</span> <span class=\"pl-c1\">nil</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-k\">return</span>\n  <span class=\"pl-k\">end</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fn</span>.<span class=\"pl-c1\">setreg</span>(<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">v</span>.<span class=\"pl-e\">register</span>, <span class=\"pl-smi\">path</span>)\n<span class=\"pl-k\">end</span>\n\n<span class=\"pl-k\">local</span> <span class=\"pl-en\">yank_relative_path</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">get_mini_files_path</span>()\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">==</span> <span class=\"pl-c1\">nil</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-k\">return</span>\n  <span class=\"pl-k\">end</span>\n\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">root</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>lazyvim.util<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">root</span>({ <span class=\"pl-smi\">normalize</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">true</span> })\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">normalized_path</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fs</span>.<span class=\"pl-c1\">normalize</span>(<span class=\"pl-smi\">path</span>)\n\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">normalized_path</span> <span class=\"pl-k\">==</span> <span class=\"pl-smi\">root</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fn</span>.<span class=\"pl-c1\">setreg</span>(<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">v</span>.<span class=\"pl-e\">register</span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>.<span class=\"pl-pds\">\"</span></span>)\n    <span class=\"pl-k\">return</span>\n  <span class=\"pl-k\">end</span>\n\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">root_prefix</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">root</span> <span class=\"pl-k\">..</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>/<span class=\"pl-pds\">\"</span></span>\n  <span class=\"pl-k\">if</span> <span class=\"pl-en\">normalized_path</span>:<span class=\"pl-c1\">sub</span>(<span class=\"pl-c1\">1</span>, <span class=\"pl-k\">#</span><span class=\"pl-smi\">root_prefix</span>) <span class=\"pl-k\">~=</span> <span class=\"pl-smi\">root_prefix</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-c1\">notify</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Entry is not under the project root<span class=\"pl-pds\">\"</span></span>)\n    <span class=\"pl-k\">return</span>\n  <span class=\"pl-k\">end</span>\n\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fn</span>.<span class=\"pl-c1\">setreg</span>(<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">v</span>.<span class=\"pl-e\">register</span>, <span class=\"pl-en\">normalized_path</span>:<span class=\"pl-c1\">sub</span>(<span class=\"pl-k\">#</span><span class=\"pl-smi\">root_prefix</span> <span class=\"pl-k\">+</span> <span class=\"pl-c1\">1</span>))\n<span class=\"pl-k\">end</span>\n\n<span class=\"pl-k\">local</span> <span class=\"pl-en\">ui_open</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">get_mini_files_path</span>()\n  <span class=\"pl-k\">if</span> <span class=\"pl-smi\">path</span> <span class=\"pl-k\">==</span> <span class=\"pl-c1\">nil</span> <span class=\"pl-k\">then</span>\n    <span class=\"pl-k\">return</span>\n  <span class=\"pl-k\">end</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">ui</span>.<span class=\"pl-c1\">open</span>(<span class=\"pl-smi\">path</span>)\n<span class=\"pl-k\">end</span>\n<span class=\"pl-c\"><span class=\"pl-c\">---</span><span class=\"pl-k\">@diagnostic</span> <span class=\"pl-k\">enable</span><span class=\"pl-k\">:</span> <span class=\"pl-c1\">undefined-global</span></span>\n\n<span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">api</span>.<span class=\"pl-c1\">nvim_create_autocmd</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>User<span class=\"pl-pds\">\"</span></span>, {\n  <span class=\"pl-smi\">group</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">mini_files_mappings</span>,\n  <span class=\"pl-smi\">pattern</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>MiniFilesBufferCreate<span class=\"pl-pds\">\"</span></span>,\n  <span class=\"pl-en\">callback</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>(<span class=\"pl-smi\">args</span>)\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">b</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">args</span>.<span class=\"pl-e\">data</span>.<span class=\"pl-e\">buf_id</span>\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">keymap</span>.<span class=\"pl-c1\">set</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>g~<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">set_cwd</span>, { <span class=\"pl-smi\">buffer</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">b</span>, <span class=\"pl-smi\">desc</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Set cwd<span class=\"pl-pds\">\" </span></span>})\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">keymap</span>.<span class=\"pl-c1\">set</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>gX<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">ui_open</span>, { <span class=\"pl-smi\">buffer</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">b</span>, <span class=\"pl-smi\">desc</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>open with default app<span class=\"pl-pds\">\" </span></span>})\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">keymap</span>.<span class=\"pl-c1\">set</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>gy<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">yank_relative_path</span>, { <span class=\"pl-smi\">buffer</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">b</span>, <span class=\"pl-smi\">desc</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Yank relative path<span class=\"pl-pds\">\" </span></span>})\n    <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">keymap</span>.<span class=\"pl-c1\">set</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>n<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>gY<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">yank_absolute_path</span>, { <span class=\"pl-smi\">buffer</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">b</span>, <span class=\"pl-smi\">desc</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Yank absolute path<span class=\"pl-pds\">\" </span></span>})\n  <span class=\"pl-k\">end</span>,\n})</pre></div>",
                    "bodyText": "You're right, thanks for pointing to the docs. I'm happy with this config:\n-- MiniFiles mappings for working with the entry under the cursor.\nlocal mini_files_mappings = vim.api.nvim_create_augroup(\"mini_files_mappings\", { clear = true })\n\n---@diagnostic disable: undefined-global\nlocal get_mini_files_path = function()\n  local path = (MiniFiles.get_fs_entry() or {}).path\n  if path == nil then\n    vim.notify(\"Cursor is not on valid entry\")\n    return nil\n  end\n  return path\nend\n\nlocal set_cwd = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n  vim.fn.chdir(vim.fs.dirname(path))\nend\n\nlocal yank_absolute_path = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n  vim.fn.setreg(vim.v.register, path)\nend\n\nlocal yank_relative_path = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n\n  local root = require(\"lazyvim.util\").root({ normalize = true })\n  local normalized_path = vim.fs.normalize(path)\n\n  if normalized_path == root then\n    vim.fn.setreg(vim.v.register, \".\")\n    return\n  end\n\n  local root_prefix = root .. \"/\"\n  if normalized_path:sub(1, #root_prefix) ~= root_prefix then\n    vim.notify(\"Entry is not under the project root\")\n    return\n  end\n\n  vim.fn.setreg(vim.v.register, normalized_path:sub(#root_prefix + 1))\nend\n\nlocal ui_open = function()\n  local path = get_mini_files_path()\n  if path == nil then\n    return\n  end\n  vim.ui.open(path)\nend\n---@diagnostic enable: undefined-global\n\nvim.api.nvim_create_autocmd(\"User\", {\n  group = mini_files_mappings,\n  pattern = \"MiniFilesBufferCreate\",\n  callback = function(args)\n    local b = args.data.buf_id\n    vim.keymap.set(\"n\", \"g~\", set_cwd, { buffer = b, desc = \"Set cwd\" })\n    vim.keymap.set(\"n\", \"gX\", ui_open, { buffer = b, desc = \"open with default app\" })\n    vim.keymap.set(\"n\", \"gy\", yank_relative_path, { buffer = b, desc = \"Yank relative path\" })\n    vim.keymap.set(\"n\", \"gY\", yank_absolute_path, { buffer = b, desc = \"Yank absolute path\" })\n  end,\n})",
