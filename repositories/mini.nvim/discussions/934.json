            },
            "authorAssociation": "NONE",
            "body": "if anyone is looking for a mini.starter integration, i wrote a function that gets recent projects from coffeebar/neovim-project :)\r\n\r\n(edited with suggestions below)\r\n```lua\r\nlocal gen_proj_list = function(size)\r\n    local projects = require(\"neovim-project.utils.history\").get_recent_projects()\r\n    local size = math.min(size, #projects)\r\n    local starter_items = {}\r\n    for i = 1, size do\r\n        local project = projects[i]\r\n        table.insert(starter_items, 1, { { name = vim.fs.basename(project), action = function()\r\n            require(\"neovim-project.project\").switch_project(project)\r\n        end, section=\"Recent Projects\" } })\r\n    end\r\n    return starter_items\r\nend\r\n```",
            "bodyHTML": "<p dir=\"auto\">if anyone is looking for a mini.starter integration, i wrote a function that gets recent projects from coffeebar/neovim-project :)</p>\n<p dir=\"auto\">(edited with suggestions below)</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"local gen_proj_list = function(size)\n    local projects = require(&quot;neovim-project.utils.history&quot;).get_recent_projects()\n    local size = math.min(size, #projects)\n    local starter_items = {}\n    for i = 1, size do\n        local project = projects[i]\n        table.insert(starter_items, 1, { { name = vim.fs.basename(project), action = function()\n            require(&quot;neovim-project.project&quot;).switch_project(project)\n        end, section=&quot;Recent Projects&quot; } })\n    end\n    return starter_items\nend\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-en\">gen_proj_list</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>(<span class=\"pl-smi\">size</span>)\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">projects</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>neovim-project.utils.history<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">get_recent_projects</span>()\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">size</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">math.min</span>(<span class=\"pl-smi\">size</span>, <span class=\"pl-k\">#</span><span class=\"pl-smi\">projects</span>)\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">starter_items</span> <span class=\"pl-k\">=</span> {}\n    <span class=\"pl-k\">for</span> <span class=\"pl-smi\">i</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">1</span>, <span class=\"pl-smi\">size</span> <span class=\"pl-k\">do</span>\n        <span class=\"pl-k\">local</span> <span class=\"pl-smi\">project</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">projects</span>[<span class=\"pl-smi\">i</span>]\n        <span class=\"pl-c1\">table.insert</span>(<span class=\"pl-smi\">starter_items</span>, <span class=\"pl-c1\">1</span>, { { <span class=\"pl-smi\">name</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fs</span>.<span class=\"pl-c1\">basename</span>(<span class=\"pl-smi\">project</span>), <span class=\"pl-en\">action</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n            <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>neovim-project.project<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">switch_project</span>(<span class=\"pl-smi\">project</span>)\n        <span class=\"pl-k\">end</span>, <span class=\"pl-smi\">section</span><span class=\"pl-k\">=</span><span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Recent Projects<span class=\"pl-pds\">\" </span></span>} })\n    <span class=\"pl-k\">end</span>\n    <span class=\"pl-k\">return</span> <span class=\"pl-smi\">starter_items</span>\n<span class=\"pl-k\">end</span></pre></div>",
            "bodyText": "if anyone is looking for a mini.starter integration, i wrote a function that gets recent projects from coffeebar/neovim-project :)\n(edited with suggestions below)\nlocal gen_proj_list = function(size)\n    local projects = require(\"neovim-project.utils.history\").get_recent_projects()\n    local size = math.min(size, #projects)\n    local starter_items = {}\n    for i = 1, size do\n        local project = projects[i]\n        table.insert(starter_items, 1, { { name = vim.fs.basename(project), action = function()\n            require(\"neovim-project.project\").switch_project(project)\n        end, section=\"Recent Projects\" } })\n    end\n    return starter_items\nend",
