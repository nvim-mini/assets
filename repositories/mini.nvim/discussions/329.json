    "comment_data": [
        {
            "author": {
                "avatarUrl": "https://avatars.githubusercontent.com/u/24854248?u=d09fd974c6720eba3039db6beb2f1c1efecdb51d&v=4",
                "login": "echasnovski",
                "resourcePath": "/echasnovski",
                "url": "https://github.com/echasnovski"
            },
            "authorAssociation": "MEMBER",
            "body": "Columns are not shrunk, but the opposite - they are padded (from left and/or right). Try using `trim` step with custom merge character. \r\n\r\nThat is:\r\n- Visually select region to be aligned.\r\n- Press `gA` to initiate interactive align.\r\n- Press `&` to align by it.\r\n- Press `t` to trim whitespace.\r\n- Press `m` followed by `<Space>` and `<CR>` (Enter).",
            "bodyHTML": "<p dir=\"auto\">Columns are not shrunk, but the opposite - they are padded (from left and/or right). Try using <code class=\"notranslate\">trim</code> step with custom merge character.</p>\n<p dir=\"auto\">That is:</p>\n<ul dir=\"auto\">\n<li>Visually select region to be aligned.</li>\n<li>Press <code class=\"notranslate\">gA</code> to initiate interactive align.</li>\n<li>Press <code class=\"notranslate\">&amp;</code> to align by it.</li>\n<li>Press <code class=\"notranslate\">t</code> to trim whitespace.</li>\n<li>Press <code class=\"notranslate\">m</code> followed by <code class=\"notranslate\">&lt;Space&gt;</code> and <code class=\"notranslate\">&lt;CR&gt;</code> (Enter).</li>\n</ul>",
            "bodyText": "Columns are not shrunk, but the opposite - they are padded (from left and/or right). Try using trim step with custom merge character.\nThat is:\n\nVisually select region to be aligned.\nPress gA to initiate interactive align.\nPress & to align by it.\nPress t to trim whitespace.\nPress m followed by <Space> and <CR> (Enter).",
