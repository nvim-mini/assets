                {
                    "author": {
                        "avatarUrl": "https://avatars.githubusercontent.com/u/16707112?v=4",
                        "login": "simonmandlik",
                        "resourcePath": "/simonmandlik",
                        "url": "https://github.com/simonmandlik"
                    },
                    "authorAssociation": "NONE",
                    "body": "Apologies, I wasn't specific enough. `srC` is working for me, but allows me to only replace the function call with a single-character surround, not rename the function call.",
