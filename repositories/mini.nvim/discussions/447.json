    "authorAssociation": "NONE",
    "body": "Perhaps a good misc addition or a separate module altogether?\r\n\r\nhttps://github.com/ku1ik/vim-pasta",
    "bodyHTML": "<p dir=\"auto\">Perhaps a good misc addition or a separate module altogether?</p>\n<p dir=\"auto\"><a href=\"https://github.com/ku1ik/vim-pasta\">https://github.com/ku1ik/vim-pasta</a></p>",
    "bodyText": "Perhaps a good misc addition or a separate module altogether?\nhttps://github.com/ku1ik/vim-pasta",
    "category": {
        "createdAt": "2022-01-02T14:24:09Z",
        "description": "Share ideas for new features",
