    "comment_count": 3,
    "comment_data": [
        {
            "author": {
                "avatarUrl": "https://avatars.githubusercontent.com/u/24854248?u=d09fd974c6720eba3039db6beb2f1c1efecdb51d&v=4",
                "login": "echasnovski",
                "resourcePath": "/echasnovski",
