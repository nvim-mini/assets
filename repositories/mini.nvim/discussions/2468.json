            "authorAssociation": "NONE",
            "body": "**Screenshot**\r\n\r\n<img width=\"1920\" height=\"199\" alt=\"screenshot-1\" src=\"https://github.com/user-attachments/assets/6a311095-e92f-4dd5-8166-4a9e32405515\" />\r\n\r\n**Configuration**\r\n\r\n```lua\r\nlocal config = function()\r\n\r\n  require(\"mini.statusline\").setup({\r\n    use_icons = true,\r\n\r\n    content = {\r\n      active = function()\r\n        local mode, mode_hl = MiniStatusline.section_mode({})\r\n        local location      = MiniStatusline.section_location({ trunc_width = 1080 })\r\n\r\n        return MiniStatusline.combine_groups({\r\n          { hl = mode_hl, strings = { mode } },\r\n          '%<',\r\n          { hl = mode_hl, strings = { location } },\r\n        })\r\n      end,\r\n    },\r\n  })\r\n\r\n  require(\"mini.tabline\").setup({\r\n    show_icons = false,\r\n  })\r\n\r\n  _G.MiniWinbar = function()\r\n    local statusline = MiniStatusline.active()\r\n    local tabline = MiniTabline.make_tabline_string()\r\n    return tabline .. '%=' .. statusline\r\n  end\r\n\r\n  -- hide bottom status line and top tab line\r\n  vim.opt.laststatus = 0\r\n  vim.opt.showtabline = 0\r\n  -- render the combined bar at the top of every window\r\n  vim.opt.winbar = \"%{%v:lua.MiniWinbar()%}\"\r\n\r\nend\r\n\r\nreturn {\r\n  \"nvim-mini/mini.statusline\",\r\n  version = '*',\r\n  dependencies = { \"nvim-mini/mini.tabline\" },\r\n  config = config\r\n}\r\n```",
