quot;,\n  version = '*',\n  dependencies = { &quot;nvim-mini/mini.tabline&quot; },\n  config = config\n}\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-en\">config</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n\n  <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.statusline<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">setup</span>({\n    <span class=\"pl-smi\">use_icons</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">true</span>,\n\n    <span class=\"pl-smi\">content</span> <span class=\"pl-k\">=</span> {\n      <span class=\"pl-en\">active</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n        <span class=\"pl-k\">local</span> <span class=\"pl-smi\">mode</span>, <span class=\"pl-smi\">mode_hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_mode</span>({})\n        <span class=\"pl-k\">local</span> <span class=\"pl-smi\">location</span>      <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">section_location</span>({ <span class=\"pl-smi\">trunc_width</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">1080</span> })\n\n        <span class=\"pl-k\">return</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">combine_groups</span>({\n          { <span class=\"pl-smi\">hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">mode_hl</span>, <span class=\"pl-smi\">strings</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">mode</span> } },\n          <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%&lt;<span class=\"pl-pds\">'</span></span>,\n          { <span class=\"pl-smi\">hl</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">mode_hl</span>, <span class=\"pl-smi\">strings</span> <span class=\"pl-k\">=</span> { <span class=\"pl-smi\">location</span> } },\n        })\n      <span class=\"pl-k\">end</span>,\n    },\n  })\n\n  <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.tabline<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">setup</span>({\n    <span class=\"pl-smi\">show_icons</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">false</span>,\n  })\n\n  <span class=\"pl-c1\">_G</span>.<span class=\"pl-en\">MiniWinbar</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">statusline</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniStatusline</span>.<span class=\"pl-c1\">active</span>()\n    <span class=\"pl-k\">local</span> <span class=\"pl-smi\">tabline</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">MiniTabline</span>.<span class=\"pl-c1\">make_tabline_string</span>()\n    <span class=\"pl-k\">return</span> <span class=\"pl-smi\">tabline</span> <span class=\"pl-k\">..</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>%=<span class=\"pl-pds\">' </span></span><span class=\"pl-k\">..</span> <span class=\"pl-smi\">statusline</span>\n  <span class=\"pl-k\">end</span>\n\n  <span class=\"pl-c\"><span class=\"pl-c\">--</span> hide bottom status line and top tab line</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">opt</span>.<span class=\"pl-e\">laststatus</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">0</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">opt</span>.<span class=\"pl-e\">showtabline</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">0</span>\n  <span class=\"pl-c\"><span class=\"pl-c\">--</span> render the combined bar at the top of every window</span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">opt</span>.<span class=\"pl-e\">winbar</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>%{%v:lua.MiniWinbar()%}<span class=\"pl-pds\">\"</span></span>\n\n<span class=\"pl-k\">end</span>\n\n<span class=\"pl-k\">return</span> {\n  <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>nvim-mini/mini.statusline<span class=\"pl-pds\">\"</span></span>,\n  <span class=\"pl-smi\">version</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">'</span>*<span class=\"pl-pds\">'</span></span>,\n  <span class=\"pl-smi\">dependencies</span> <span class=\"pl-k\">=</span> { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>nvim-mini/mini.tabline<span class=\"pl-pds\">\" </span></span>},\n  <span class=\"pl-smi\">config</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">config</span>\n}</pre></div>",
            "bodyText": "Screenshot\n\nConfiguration\nlocal config = function()\n\n  require(\"mini.statusline\").setup({\n    use_icons = true,\n\n    content = {\n      active = function()\n        local mode, mode_hl = MiniStatusline.section_mode({})\n        local location      = MiniStatusline.section_location({ trunc_width = 1080 })\n\n        return MiniStatusline.combine_groups({\n          { hl = mode_hl, strings = { mode } },\n          '%<',\n          { hl = mode_hl, strings = { location } },\n        })\n      end,\n    },\n  })\n\n  require(\"mini.tabline\").setup({\n    show_icons = false,\n  })\n\n  _G.MiniWinbar = function()\n    local statusline = MiniStatusline.active()\n    local tabline = MiniTabline.make_tabline_string()\n    return tabline .. '%=' .. statusline\n  end\n\n  -- hide bottom status line and top tab line\n  vim.opt.laststatus = 0\n  vim.opt.showtabline = 0\n  -- render the combined bar at the top of every window\n  vim.opt.winbar = \"%{%v:lua.MiniWinbar()%}\"\n\nend\n\nreturn {\n  \"nvim-mini/mini.statusline\",\n  version = '*',\n  dependencies = { \"nvim-mini/mini.tabline\" },\n  config = config\n}",
