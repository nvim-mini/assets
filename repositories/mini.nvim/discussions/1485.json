span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.icons<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">setup</span>()\n\t<span class=\"pl-k\">end</span>\n}</pre></div>\n<p dir=\"auto\">My setup in completion. I expected show icons.</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"return { \n\t'echasnovski/mini.completion', version = false,\n\tdependencies = {'echasnovski/mini.icons'},\nconfig = function()\n\trequire(&quot;mini.completion&quot;).setup()\n\tend\n\n}\n\"><pre class=\"notranslate\"><span class=\"pl-k\">return</span> { \n\t<span class=\"pl-s\"><span class=\"pl-pds\">'</span>echasnovski/mini.completion<span class=\"pl-pds\">'</span></span>, <span class=\"pl-smi\">version</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">false</span>,\n\t<span class=\"pl-smi\">dependencies</span> <span class=\"pl-k\">=</span> {<span class=\"pl-s\"><span class=\"pl-pds\">'</span>echasnovski/mini.icons<span class=\"pl-pds\">'</span></span>},\n<span class=\"pl-en\">config</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>()\n\t<span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.completion<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">setup</span>()\n\t<span class=\"pl-k\">end</span>\n\n}\n</pre></div>\n<p dir=\"auto\"><a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/echasnovski/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/echasnovski\">@echasnovski</a></p>",
                    "bodyText": "Yes it work.\nThanks you so much. I facing another issue.\nIt seems i can't make mini.icons work with mini.autocompletion.\n\nThis is how i setup my mini.icons\nreturn { 'echasnovski/mini.icons', version = false,\n\tconfig = function()\n\trequire(\"mini.icons\").setup()\n\tend\n}\nMy setup in completion. I expected show icons.\nreturn { \n\t'echasnovski/mini.completion', version = false,\n\tdependencies = {'echasnovski/mini.icons'},\nconfig = function()\n\trequire(\"mini.completion\").setup()\n\tend\n\n}\n\n@echasnovski",
