                    "authorAssociation": "NONE",
                    "body": "It isn't obvious to me how you can just tweak the output without patching the source code. Would you accept a PR with this change?\r\n\r\n```diff\r\ndiff --git a/lua/mini/test.lua b/lua/mini/test.lua\r\nindex df811fa..86c2ca9 100644\r\n--- a/lua/mini/test.lua\r\n+++ b/lua/mini/test.lua\r\n@@ -1055,10 +1055,11 @@ end\r\n ---   - <quit_on_finish> - whether to quit after finishing test execution.\r\n ---     Default: `true`.\r\n MiniTest.gen_reporter.stdout = function(opts)\r\n-  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true }, opts or {})\r\n+  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true, color = true }, opts or {})\r\n \r\n   local write = function(text)\r\n     text = type(text) == 'table' and table.concat(text, '\\n') or text\r\n+    text = opts.color and text or text:gsub('\\27%[.-m', '')\r\n     io.stdout:write(text)\r\n     io.flush()\r\n   end\r\n```",
                    "bodyHTML": "<p dir=\"auto\">It isn't obvious to me how you can just tweak the output without patching the source code. Would you accept a PR with this change?</p>\n<div class=\"highlight highlight-source-diff notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"diff --git a/lua/mini/test.lua b/lua/mini/test.lua\nindex df811fa..86c2ca9 100644\n--- a/lua/mini/test.lua\n+++ b/lua/mini/test.lua\n@@ -1055,10 +1055,11 @@ end\n ---   - &lt;quit_on_finish&gt; - whether to quit after finishing test execution.\n ---     Default: `true`.\n MiniTest.gen_reporter.stdout = function(opts)\n-  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true }, opts or {})\n+  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true, color = true }, opts or {})\n \n   local write = function(text)\n     text = type(text) == 'table' and table.concat(text, '\\n') or text\n+    text = opts.color and text or text:gsub('\\27%[.-m', '')\n     io.stdout:write(text)\n     io.flush()\n   end\"><pre class=\"notranslate\"><span class=\"pl-c1\">diff --git a/lua/mini/test.lua b/lua/mini/test.lua</span>\nindex df811fa..86c2ca9 100644\n<span class=\"pl-md\">--- a/lua/mini/test.lua</span>\n<span class=\"pl-mi1\">+++ b/lua/mini/test.lua</span>\n<span class=\"pl-mdr\">@@ -1055,10 +1055,11 @@</span> end\n ---   - &lt;quit_on_finish&gt; - whether to quit after finishing test execution.\n ---     Default: `true`.\n MiniTest.gen_reporter.stdout = function(opts)\n<span class=\"pl-md\"><span class=\"pl-md\">-</span>  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true }, opts or {})</span>\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span>  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true, color = true }, opts or {})</span>\n \n   local write = function(text)\n     text = type(text) == 'table' and table.concat(text, '\\n') or text\n<span class=\"pl-mi1\"><span class=\"pl-mi1\">+</span>    text = opts.color and text or text:gsub('\\27%[.-m', '')</span>\n     io.stdout:write(text)\n     io.flush()\n   end</pre></div>",
                    "bodyText": "It isn't obvious to me how you can just tweak the output without patching the source code. Would you accept a PR with this change?\ndiff --git a/lua/mini/test.lua b/lua/mini/test.lua\nindex df811fa..86c2ca9 100644\n--- a/lua/mini/test.lua\n+++ b/lua/mini/test.lua\n@@ -1055,10 +1055,11 @@ end\n ---   - <quit_on_finish> - whether to quit after finishing test execution.\n ---     Default: `true`.\n MiniTest.gen_reporter.stdout = function(opts)\n-  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true }, opts or {})\n+  opts = vim.tbl_deep_extend('force', { group_depth = 1, quit_on_finish = true, color = true }, opts or {})\n \n   local write = function(text)\n     text = type(text) == 'table' and table.concat(text, '\\n') or text\n+    text = opts.color and text or text:gsub('\\27%[.-m', '')\n     io.stdout:write(text)\n     io.flush()\n   end",
