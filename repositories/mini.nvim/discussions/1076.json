                    "authorAssociation": "NONE",
                    "body": "After digging around the source code a bit, I came up with a decent solution. Looks a bit cryptic\r\n\r\n```lua\r\nlocal spec_pair = require(\"mini.ai\").gen_spec.pair\r\nlocal opts = {\r\n    custom_textobjects = {\r\n    [\"(\"] = function(ai_type, _, opts)\r\n    -- Force the search method to always be \"cover\"\r\n    opts.search_method = \"cover\"\r\n    -- This will use the pattern supply by \"_(\" below\r\n    return require(\"mini.ai\").find_textobject(ai_type, \"_(\", opts)\r\n  end,\r\n\r\n  [\"_(\"] = { \"%b()\", \"^.().*().$\" }\r\n}\r\n\r\nrequire(\"mini.ai\").setup(opts)\r\n```",
                    "bodyHTML": "<p dir=\"auto\">After digging around the source code a bit, I came up with a decent solution. Looks a bit cryptic</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"local spec_pair = require(&quot;mini.ai&quot;).gen_spec.pair\nlocal opts = {\n    custom_textobjects = {\n    [&quot;(&quot;] = function(ai_type, _, opts)\n    -- Force the search method to always be &quot;cover&quot;\n    opts.search_method = &quot;cover&quot;\n    -- This will use the pattern supply by &quot;_(&quot; below\n    return require(&quot;mini.ai&quot;).find_textobject(ai_type, &quot;_(&quot;, opts)\n  end,\n\n  [&quot;_(&quot;] = { &quot;%b()&quot;, &quot;^.().*().$&quot; }\n}\n\nrequire(&quot;mini.ai&quot;).setup(opts)\"><pre class=\"notranslate\"><span class=\"pl-k\">local</span> <span class=\"pl-smi\">spec_pair</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.ai<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-e\">gen_spec</span>.<span class=\"pl-e\">pair</span>\n<span class=\"pl-k\">local</span> <span class=\"pl-smi\">opts</span> <span class=\"pl-k\">=</span> {\n    <span class=\"pl-smi\">custom_textobjects</span> <span class=\"pl-k\">=</span> {\n    [<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>(<span class=\"pl-pds\">\"</span></span>] <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>(<span class=\"pl-smi\">ai_type</span>, <span class=\"pl-smi\">_</span>, <span class=\"pl-smi\">opts</span>)\n    <span class=\"pl-c\"><span class=\"pl-c\">--</span> Force the search method to always be \"cover\"</span>\n    <span class=\"pl-smi\">opts</span>.<span class=\"pl-e\">search_method</span> <span class=\"pl-k\">=</span> <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>cover<span class=\"pl-pds\">\"</span></span>\n    <span class=\"pl-c\"><span class=\"pl-c\">--</span> This will use the pattern supply by \"_(\" below</span>\n    <span class=\"pl-k\">return</span> <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.ai<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">find_textobject</span>(<span class=\"pl-smi\">ai_type</span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>_(<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-smi\">opts</span>)\n  <span class=\"pl-k\">end</span>,\n\n  [<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>_(<span class=\"pl-pds\">\"</span></span>] <span class=\"pl-k\">=</span> { <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>%b()<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>^.().*().$<span class=\"pl-pds\">\" </span></span>}\n}\n\n<span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.ai<span class=\"pl-pds\">\"</span></span>).<span class=\"pl-c1\">setup</span>(<span class=\"pl-smi\">opts</span>)</pre></div>",
                    "bodyText": "After digging around the source code a bit, I came up with a decent solution. Looks a bit cryptic\nlocal spec_pair = require(\"mini.ai\").gen_spec.pair\nlocal opts = {\n    custom_textobjects = {\n    [\"(\"] = function(ai_type, _, opts)\n    -- Force the search method to always be \"cover\"\n    opts.search_method = \"cover\"\n    -- This will use the pattern supply by \"_(\" below\n    return require(\"mini.ai\").find_textobject(ai_type, \"_(\", opts)\n  end,\n\n  [\"_(\"] = { \"%b()\", \"^.().*().$\" }\n}\n\nrequire(\"mini.ai\").setup(opts)",
