    "body": "### Contributing guidelines\n\n- [X] I have read [CODE_OF_CONDUCT.md](https://github.com/nvim-mini/mini.nvim/blob/main/CODE_OF_CONDUCT.md)\n\n### Module(s)\n\nmini.completion\n\n### Question\n\nhttps://github.com/user-attachments/assets/ddd92423-f8bd-4b4c-85cf-361b482dcf0c\r\n\r\nmy cup.lua:\r\nlocal now = MiniDeps.now\r\nnow(function()\r\n\trequire('mini.completion').setup()\r\n\tlocal gen_loader = require('mini.snippets').gen_loader\r\n\trequire('mini.snippets').setup({\r\n\t\tmappings = {\r\n\t\t\tjump_next = '<tab>',\r\n\t\t\tjump_prev = '<s-tab>',\r\n\t\t},\r\n\t\tsnippets = {\r\n\t\t\tgen_loader.from_lang(),\r\n\t\t},\r\n\t})\r\n\tMiniSnippets.start_lsp_server()\r\nend)\r\n\r\nlocal keys = {\r\n\t['cr']        = vim.api.nvim_replace_termcodes('<CR>', true, true, true),\r\n\t['ctrl-y']    = vim.api.nvim_replace_termcodes('<C-y>', true, true, true),\r\n\t['ctrl-y_cr'] = vim.api.nvim_replace_termcodes('<C-y><CR>', true, true, true),\r\n}\r\n_G.cr_action = function()\r\n\tif vim.fn.pumvisible() ~= 0 then\r\n\t\tlocal item_selected = vim.fn.complete_info()['selected'] ~= -1\r\n\t\treturn item_selected and keys['ctrl-y'] or keys['ctrl-y_cr']\r\n\telse\r\n\t\treturn keys['cr']\r\n\tend\r\nend\r\nvim.api.nvim_set_keymap('i', '<CR>', 'v:lua._G.cr_action()', { noremap = true, expr = true })\r\nvim.api.nvim_set_keymap('i', '<Tab>', [[pumvisible() ? \"\\<C-n>\" : \"\\<Tab>\"]], { noremap = true, expr = true })\r\nvim.api.nvim_set_keymap('i', '<S-Tab>', [[pumvisible() ? \"\\<C-p>\" : \"\\<S-Tab>\"]], { noremap = true, expr = true })\r\n",
    "bodyHTML": "<h3 dir=\"auto\">Contributing guidelines</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Completed task\" checked=\"\"> I have read <a href=\"https://github.com/nvim-mini/mini.nvim/blob/main/CODE_OF_CONDUCT.md\">CODE_OF_CONDUCT.md</a></li>\n</ul>\n<h3 dir=\"auto\">Module(s)</h3>\n<p dir=\"auto\">mini.completion</p>\n<h3 dir=\"auto\">Question</h3>\n<details open=\"\" class=\"details-reset border rounded-2\">\n  <summary class=\"tmp-px-3 py-2\">\n    <svg aria-hidden=\"true\" data-component=\"Octicon\" height=\"16\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" data-view-component=\"true\" class=\"octicon octicon-device-camera-video\">\n    <path d=\"M16 3.75v8.5a.75.75 0 0 1-1.136.643L11 10.575v.675A1.75 1.75 0 0 1 9.25 13h-7.5A1.75 1.75 0 0 1 0 11.25v-6.5C0 3.784.784 3 1.75 3h7.5c.966 0 1.75.784 1.75 1.75v.675l3.864-2.318A.75.75 0 0 1 16 3.75Zm-6.5 1a.25.25 0 0 0-.25-.25h-7.5a.25.25 0 0 0-.25.25v6.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-6.5ZM11 8.825l3.5 2.1v-5.85l-3.5 2.1Z\"></path>\n</svg>\n    <span class=\"m-1\">11.mov</span>\n    <span class=\"dropdown-caret\"></span>\n  </summary>\n\n  <video src=\"https://private-user-images.githubusercontent.com/41811005/483784154-ddd92423-f8bd-4b4c-85cf-361b482dcf0c.mov?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..9LnlWNjT75_iAmyTjiiST73ImaVb9Vdzop2JOp7oypY\" data-canonical-src=\"https://private-user-images.githubusercontent.com/41811005/483784154-ddd92423-f8bd-4b4c-85cf-361b482dcf0c.mov?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..9LnlWNjT75_iAmyTjiiST73ImaVb9Vdzop2JOp7oypY\" controls=\"controls\" muted=\"muted\" class=\"d-block rounded-bottom-2 border-top width-fit\" style=\"max-height:640px; min-height: 200px\">\n\n  </video>\n</details>\n\n<p dir=\"auto\">my cup.lua:<br>\nlocal now = MiniDeps.now<br>\nnow(function()<br>\nrequire('mini.completion').setup()<br>\nlocal gen_loader = require('mini.snippets').gen_loader<br>\nrequire('mini.snippets').setup({<br>\nmappings = {<br>\njump_next = '',<br>\njump_prev = '',<br>\n},<br>\nsnippets = {<br>\ngen_loader.from_lang(),<br>\n},<br>\n})<br>\nMiniSnippets.start_lsp_server()<br>\nend)</p>\n<p dir=\"auto\">local keys = {<br>\n['cr']        = vim.api.nvim_replace_termcodes('', true, true, true),<br>\n['ctrl-y']    = vim.api.nvim_replace_termcodes('', true, true, true),<br>\n['ctrl-y_cr'] = vim.api.nvim_replace_termcodes('', true, true, true),<br>\n}<br>\n_G.cr_action = function()<br>\nif vim.fn.pumvisible() ~= 0 then<br>\nlocal item_selected = vim.fn.complete_info()['selected'] ~= -1<br>\nreturn item_selected and keys['ctrl-y'] or keys['ctrl-y_cr']<br>\nelse<br>\nreturn keys['cr']<br>\nend<br>\nend<br>\nvim.api.nvim_set_keymap('i', '', 'v:lua._G.cr_action()', { noremap = true, expr = true })<br>\nvim.api.nvim_set_keymap('i', '', [[pumvisible() ? \"&lt;C-n&gt;\" : \"&lt;Tab&gt;\"]], { noremap = true, expr = true })<br>\nvim.api.nvim_set_keymap('i', '', [[pumvisible() ? \"&lt;C-p&gt;\" : \"&lt;S-Tab&gt;\"]], { noremap = true, expr = true })</p>",
    "bodyText": "Contributing guidelines\n\n I have read CODE_OF_CONDUCT.md\n\nModule(s)\nmini.completion\nQuestion\n\n  \n    \n    \n\n    11.mov\n    \n  \n\n  \n\n  \n\n\nmy cup.lua:\nlocal now = MiniDeps.now\nnow(function()\nrequire('mini.completion').setup()\nlocal gen_loader = require('mini.snippets').gen_loader\nrequire('mini.snippets').setup({\nmappings = {\njump_next = '',\njump_prev = '',\n},\nsnippets = {\ngen_loader.from_lang(),\n},\n})\nMiniSnippets.start_lsp_server()\nend)\nlocal keys = {\n['cr']        = vim.api.nvim_replace_termcodes('', true, true, true),\n['ctrl-y']    = vim.api.nvim_replace_termcodes('', true, true, true),\n['ctrl-y_cr'] = vim.api.nvim_replace_termcodes('', true, true, true),\n}\n_G.cr_action = function()\nif vim.fn.pumvisible() ~= 0 then\nlocal item_selected = vim.fn.complete_info()['selected'] ~= -1\nreturn item_selected and keys['ctrl-y'] or keys['ctrl-y_cr']\nelse\nreturn keys['cr']\nend\nend\nvim.api.nvim_set_keymap('i', '', 'v:lua._G.cr_action()', { noremap = true, expr = true })\nvim.api.nvim_set_keymap('i', '', [[pumvisible() ? \"<C-n>\" : \"<Tab>\"]], { noremap = true, expr = true })\nvim.api.nvim_set_keymap('i', '', [[pumvisible() ? \"<C-p>\" : \"<S-Tab>\"]], { noremap = true, expr = true })",
