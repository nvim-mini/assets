    "authorAssociation": "NONE",
    "body": "I can't get used to use register, I prefer to use command + v, so I overwrite the behavior of mini pick with the following snippet:\r\n```lua\r\n  local paste_orig = vim.paste\r\n  local mini_pick = require(\"mini.pick\")\r\n  mini_pick.setup({})\r\n  ---@diagnostic disable-next-line: duplicate-set-field\r\n  vim.paste = function(...)\r\n    if not mini_pick.is_picker_active() then\r\n      return paste_orig(...)\r\n    else\r\n      local reg_contents = vim.fn.getreg(\"+\"):gsub(\"[\\n\\t]\", \" \")\r\n      local char_table = {}\r\n      local len = vim.fn.strchars(reg_contents)\r\n\r\n      for i = 0, len - 1 do\r\n        table.insert(char_table, vim.fn.strcharpart(reg_contents, i, 1))\r\n      end\r\n      mini_pick.set_picker_query(char_table)\r\n    end\r\n  end\r\n```",
    "bodyHTML": "<p dir=\"auto\">I can't get used to use register, I prefer to use command + v, so I overwrite the behavior of mini pick with the following snippet:</p>\n<div class=\"highlight highlight-source-lua notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"  local paste_orig = vim.paste\n  local mini_pick = require(&quot;mini.pick&quot;)\n  mini_pick.setup({})\n  ---@diagnostic disable-next-line: duplicate-set-field\n  vim.paste = function(...)\n    if not mini_pick.is_picker_active() then\n      return paste_orig(...)\n    else\n      local reg_contents = vim.fn.getreg(&quot;+&quot;):gsub(&quot;[\\n\\t]&quot;, &quot; &quot;)\n      local char_table = {}\n      local len = vim.fn.strchars(reg_contents)\n\n      for i = 0, len - 1 do\n        table.insert(char_table, vim.fn.strcharpart(reg_contents, i, 1))\n      end\n      mini_pick.set_picker_query(char_table)\n    end\n  end\"><pre class=\"notranslate\">  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">paste_orig</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">paste</span>\n  <span class=\"pl-k\">local</span> <span class=\"pl-smi\">mini_pick</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">require</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>mini.pick<span class=\"pl-pds\">\"</span></span>)\n  <span class=\"pl-smi\">mini_pick</span>.<span class=\"pl-c1\">setup</span>({})\n  <span class=\"pl-c\"><span class=\"pl-c\">---</span><span class=\"pl-k\">@diagnostic</span> <span class=\"pl-k\">disable-next-line</span><span class=\"pl-k\">:</span> <span class=\"pl-c1\">duplicate-set-field</span></span>\n  <span class=\"pl-smi\">vim</span>.<span class=\"pl-en\">paste</span> <span class=\"pl-k\">=</span> <span class=\"pl-k\">function</span>(...)\n    <span class=\"pl-k\">if</span> <span class=\"pl-k\">not</span> <span class=\"pl-smi\">mini_pick</span>.<span class=\"pl-c1\">is_picker_active</span>() <span class=\"pl-k\">then</span>\n      <span class=\"pl-k\">return</span> <span class=\"pl-c1\">paste_orig</span>(<span class=\"pl-c1\">...</span>)\n    <span class=\"pl-k\">else</span>\n      <span class=\"pl-k\">local</span> <span class=\"pl-smi\">reg_contents</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fn</span>.<span class=\"pl-c1\">getreg</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>+<span class=\"pl-pds\">\"</span></span>):<span class=\"pl-c1\">gsub</span>(<span class=\"pl-s\"><span class=\"pl-pds\">\"</span>[<span class=\"pl-cce\">\\n\\t</span>]<span class=\"pl-pds\">\"</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">\"</span> <span class=\"pl-pds\">\"</span></span>)\n      <span class=\"pl-k\">local</span> <span class=\"pl-smi\">char_table</span> <span class=\"pl-k\">=</span> {}\n      <span class=\"pl-k\">local</span> <span class=\"pl-smi\">len</span> <span class=\"pl-k\">=</span> <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fn</span>.<span class=\"pl-c1\">strchars</span>(<span class=\"pl-smi\">reg_contents</span>)\n\n      <span class=\"pl-k\">for</span> <span class=\"pl-smi\">i</span> <span class=\"pl-k\">=</span> <span class=\"pl-c1\">0</span>, <span class=\"pl-smi\">len</span> <span class=\"pl-k\">-</span> <span class=\"pl-c1\">1</span> <span class=\"pl-k\">do</span>\n        <span class=\"pl-c1\">table.insert</span>(<span class=\"pl-smi\">char_table</span>, <span class=\"pl-smi\">vim</span>.<span class=\"pl-e\">fn</span>.<span class=\"pl-c1\">strcharpart</span>(<span class=\"pl-smi\">reg_contents</span>, <span class=\"pl-smi\">i</span>, <span class=\"pl-c1\">1</span>))\n      <span class=\"pl-k\">end</span>\n      <span class=\"pl-smi\">mini_pick</span>.<span class=\"pl-c1\">set_picker_query</span>(<span class=\"pl-smi\">char_table</span>)\n    <span class=\"pl-k\">end</span>\n  <span class=\"pl-k\">end</span></pre></div>",
    "bodyText": "I can't get used to use register, I prefer to use command + v, so I overwrite the behavior of mini pick with the following snippet:\n  local paste_orig = vim.paste\n  local mini_pick = require(\"mini.pick\")\n  mini_pick.setup({})\n  ---@diagnostic disable-next-line: duplicate-set-field\n  vim.paste = function(...)\n    if not mini_pick.is_picker_active() then\n      return paste_orig(...)\n    else\n      local reg_contents = vim.fn.getreg(\"+\"):gsub(\"[\\n\\t]\", \" \")\n      local char_table = {}\n      local len = vim.fn.strchars(reg_contents)\n\n      for i = 0, len - 1 do\n        table.insert(char_table, vim.fn.strcharpart(reg_contents, i, 1))\n      end\n      mini_pick.set_picker_query(char_table)\n    end\n  end",
